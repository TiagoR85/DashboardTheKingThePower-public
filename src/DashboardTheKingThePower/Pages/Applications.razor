    private IEnumerable<Application> filteredApplications => applications
        .Where(a =>
            (filterCategory == "all" || a.Category == filterCategory) &&
            (filterStatus == "all" || a.Status == filterStatus) &&
            (string.IsNullOrEmpty(searchTerm) ||
                a.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                a.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private string GetStatusVariant(string status) => status switch
    {
        "Active" => "success",
        "Inactive" => "default",
        "Update Available" => "warning",
        _ => "default"
    };

    private void UninstallApp(Application app)
    {
        uninstallTarget = app;
        showUninstallModal = true;
    }

    private void ConfirmUninstall()
    {
        if (uninstallTarget is not null)
        {
            applications.RemoveAll(a => a.Id == uninstallTarget.Id);
        }
        showUninstallModal = false;
        uninstallTarget = null;
    }

    private void InstallApp()
    {
        var newApp = new Application(
            $"new-{DateTime.Now.Ticks}",
            $"Novo App {applications.Count + 1}",
            "Um aplicativo recém-instalado",
            "1.0.0",
            "Active",
            "Productivity",
            "#6366F1",
            "Agora mesmo",
            "<svg class='w-6 h-6' fill='currentColor' viewBox='0 0 24 24'><path d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'/></svg>"
        );
        applications.Add(newApp);
        ShowMessage($"Instalando {newApp.Name}...");
    }

    private void OpenApp(Application app)
    {
        ShowMessage($"Abrindo {app.Name}...");
    }

    private void OpenSettings(Application app)
    {
        ShowMessage($"Abrindo configurações de {app.Name}...");
    }

    private void ShowMessage(string message)
    {
        _messageText = message;
        _showMessage = true;
        StateHasChanged();

        _hideTimer?.Dispose();
        _hideTimer = new System.Timers.Timer(3000);
        _hideTimer.Elapsed += (sender, args) =>
        {
            _showMessage = false;
            _hideTimer?.Dispose();
            _hideTimer = null;
            InvokeAsync(StateHasChanged);
        };
        _hideTimer.AutoReset = false;
        _hideTimer.Start();
    }

    public void Dispose()
    {
        _hideTimer?.Dispose();
    }

    public record Application(string Id, string Name, string Description, string Version, string Status, string Category, string IconColor, string LastUpdated, string Icon);
}