@page "/applications"
@using DashboardTheKingThePower.Components.ui
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Aplicações</PageTitle>

@if (_showMessage)
{
    <div class="fixed top-4 right-4 z-50 bg-green-500 text-white px-4 py-3 rounded-lg shadow-lg transition-all duration-300 transform translate-y-0 opacity-100" id="toast-banner">
        <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span>@_messageText</span>
        </div>
    </div>
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Aplicações</h1>
    <Button OnClick="@(() => InstallApp())">+ Instalar App</Button>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
    <Card>
        <div class="p-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-[var(--muted-foreground)]">Total de Apps</p>
                    <p class="text-2xl font-bold mt-1">@applications.Count</p>
                </div>
                <div class="w-10 h-10 rounded-lg bg-blue-500/10 flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                </div>
            </div>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-[var(--muted-foreground)]">Ativo</p>
                    <p class="text-2xl font-bold mt-1 text-green-500">@applications.Count(a => a.Status == "Active")</p>
                </div>
                <div class="w-10 h-10 rounded-lg bg-green-500/10 flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                </div>
            </div>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-[var(--muted-foreground)]">Atualizações Disponíveis</p>
                    <p class="text-2xl font-bold mt-1 text-yellow-500">@applications.Count(a => a.Status == "Update Available")</p>
                </div>
                <div class="w-10 h-10 rounded-lg bg-yellow-500/10 flex items-center justify-center">
                    <svg class="w-5 h-5 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                </div>
            </div>
        </div>
    </Card>
</div>

<Card>
    <div class="p-4 border-b border-[var(--border)] flex flex-wrap items-center gap-4">
        <div class="relative flex-1 min-w-[200px]">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--muted-foreground)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            <input class="w-full pl-10 pr-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="Buscar aplicações..." @bind="searchTerm" />
        </div>
        <select class="px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="filterCategory">
            <option value="all">Todas as Categorias</option>
            <option value="Productivity">Produtividade</option>
            <option value="Communication">Comunicação</option>
            <option value="Analytics">Análises</option>
            <option value="Security">Segurança</option>
            <option value="Development">Desenvolvimento</option>
            <option value="Finance">Finanças</option>
            <option value="Marketing">Marketing</option>
        </select>
        <select class="px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="filterStatus">
            <option value="all">Todos os Status</option>
            <option value="Active">Ativo</option>
            <option value="Inactive">Inativo</option>
            <option value="Update Available">Atualização Disponível</option>
        </select>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 p-4">
        @foreach (var app in filteredApplications)
        {
            <div class="group relative border border-[var(--border)] rounded-xl bg-[var(--background)] p-5 transition-all duration-200 hover:shadow-lg hover:shadow-black/5 hover:border-[var(--primary)]/30 hover:-translate-y-0.5">
                <div class="flex items-start gap-4 mb-3">
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center text-white shrink-0" style="background-color: @app.IconColor;">
                        @((MarkupString)app.Icon)
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <h3 class="font-semibold truncate">@app.Name</h3>
                            <Badge Variant="@GetStatusVariant(app.Status)">@app.Status</Badge>
                        </div>
                        <p class="text-sm text-[var(--muted-foreground)] line-clamp-2">@app.Description</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 text-xs text-[var(--muted-foreground)] mb-4">
                    <span class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                        @app.Category
                    </span>
                    <span class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        v@app.Version
                    </span>
                    <span class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        @app.LastUpdated
                    </span>
                </div>

                <div class="flex items-center gap-2 pt-3 border-t border-[var(--border)]">
                    <Button Variant="ghost" Size="sm" OnClick="@(() => OpenApp(app))">Abrir</Button>
                    <Button Variant="ghost" Size="sm" OnClick="@(() => OpenSettings(app))">Configurações</Button>
                    <div class="flex-1"></div>
                    <button class="text-xs text-red-500 hover:text-red-700 transition-colors" @onclick="() => UninstallApp(app)">Desinstalar</button>
                </div>
            </div>
        }
    </div>
    @if (!filteredApplications.Any())
    {
        <div class="p-12 text-center">
            <svg class="w-12 h-12 mx-auto text-[var(--muted-foreground)] mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            <p class="text-[var(--muted-foreground)]">Nenhuma aplicação encontrada com os critérios informados.</p>
        </div>
    }
</Card>

@if (showUninstallModal)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-[var(--background)] border border-[var(--border)] rounded-lg p-6 w-full max-w-md">
            <h3 class="text-lg font-bold mb-2">Desinstalar Aplicação</h3>
            <p class="text-[var(--muted-foreground)] mb-6">Tem certeza de que deseja desinstalar <strong>@uninstallTarget?.Name</strong>? Isso removerá todos os dados e configurações associados.</p>
            <div class="flex justify-end gap-2">
                <Button Variant="secondary" OnClick="@(() => { showUninstallModal = false; uninstallTarget = null; })">Cancelar</Button>
                <button class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 text-sm font-medium" @onclick="ConfirmUninstall">Desinstalar</button>
            </div>
        </div>
    </div>
}
