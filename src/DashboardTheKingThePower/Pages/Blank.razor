@page "/blank"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Página em branco</PageTitle>

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold">Página em branco</h1>
        <p class="text-sm text-[var(--muted-foreground)] mt-1">Template vazio para começar uma tela nova.</p>
    </div>
    <nav class="text-sm text-[var(--muted-foreground)]">
        <a href="" class="hover:text-[var(--foreground)]">Início</a> <span class="mx-1">/</span> <span class="text-[var(--foreground)]">Em branco</span>
    </nav>
</div>

<div class="border border-dashed border-[var(--border)] rounded-lg p-12 text-center">
    <p class="text-sm text-[var(--muted-foreground)]">Conteúdo da página vai aqui.</p>
</div>
