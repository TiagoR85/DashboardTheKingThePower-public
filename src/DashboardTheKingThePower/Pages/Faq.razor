@page "/faq"
@using DashboardTheKingThePower.Models
@using DashboardTheKingThePower.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>FAQ</PageTitle>

<div class="max-w-3xl">
    <h1 class="text-2xl font-bold mb-2">Perguntas frequentes</h1>
    <p class="text-sm text-[var(--muted-foreground)] mb-6">Respostas rápidas sobre o uso do dashboard.</p>

    <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm mb-6"
           placeholder="Buscar pergunta..." @bind="searchTerm" @bind:event="oninput" />

    <div class="space-y-3">
        @foreach (var item in FaqFilter.Filter(items, searchTerm))
        {
            <div class="border border-[var(--border)] rounded-lg bg-[var(--card)] overflow-hidden">
                <button class="w-full flex items-center justify-between px-4 py-3 text-left text-sm font-medium hover:bg-[var(--secondary)] transition-colors"
                        aria-expanded="@(openId == item.Id ? "true" : "false")" aria-controls="@($"faq-panel-{item.Id}")"
                        @onclick="() => Toggle(item.Id)">
                    <span>@item.Question</span>
                    <span class="text-xs text-[var(--muted-foreground)]">@item.Category</span>
                </button>
                @if (openId == item.Id)
                {
                    <div id="@($"faq-panel-{item.Id}")" class="px-4 pb-4 text-sm text-[var(--muted-foreground)] border-t border-[var(--border)] pt-3">
                        @item.Answer
                    </div>
                }
            </div>
        }
        @if (!FaqFilter.Filter(items, searchTerm).Any())
        {
            <p class="text-sm text-[var(--muted-foreground)] text-center py-8">Nenhuma pergunta encontrada.</p>
        }
    </div>
</div>

@code {
    private string searchTerm = "";
    private string? openId = null;

    private void Toggle(string id) => openId = openId == id ? null : id;

    private List<FaqItem> items = new()
    {
        new() { Id = "1", Question = "Como faço login?", Answer = "Na primeira acesso, crie sua conta em Registrar. Depois use email e senha na tela de acesso — não há credencial padrão.", Category = "Conta" },
        new() { Id = "2", Question = "Como troco o tema claro/escuro?", Answer = "Clique no ícone de lua/sol no topo da tela ou use Ctrl+K e escolha \"Toggle Theme\".", Category = "Interface" },
        new() { Id = "3", Question = "Como troco a cor de destaque?", Answer = "No menu de temas há 6 opções: esmeralda, azul, violeta, rosa, laranja e ardósia.", Category = "Interface" },
        new() { Id = "4", Question = "O que é o Ctrl+K?", Answer = "Abre a paleta de comandos: pesquise páginas, ações e atalhos sem tirar as mãos do teclado.", Category = "Interface" },
        new() { Id = "5", Question = "Meus dados ficam onde?", Answer = "Tudo é salvo localmente no seu navegador (localStorage). Nada é enviado para servidores.", Category = "Privacidade" },
        new() { Id = "6", Question = "Como recupero minha senha?", Answer = "Na tela de acesso, clique em \"Esqueci minha senha\". Como os dados são locais, basta recriar a conta com o mesmo email.", Category = "Conta" },
        new() { Id = "7", Question = "Posso usar no celular?", Answer = "Sim. O layout é responsivo: o menu vira gaveta lateral e as tabelas rolam horizontalmente.", Category = "Interface" },
        new() { Id = "8", Question = "Como adiciono tarefas no Kanban?", Answer = "Use \"+ Adicionar Tarefa\" ou arraste os cartões entre as colunas com o mouse.", Category = "Uso" },
    };
}
