@page "/files"
@using DashboardTheKingThePower.Components.ui
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Arquivos</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Arquivos</h1>
    <div class="flex items-center gap-2">
        <button class="px-3 py-2 border border-[var(--border)] rounded-lg hover:bg-[var(--muted)] text-sm">Enviar</button>
        <button class="px-3 py-2 bg-[var(--primary)] text-white rounded-lg hover:opacity-90 text-sm">Nova Pasta</button>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <Card>
        <div class="p-4">
            <nav class="space-y-1">
                <button class="w-full flex items-center gap-2 px-3 py-2 text-sm rounded-lg @(currentFolder == "all" ? "bg-[var(--primary)] text-white" : "hover:bg-[var(--muted)]")" @onclick="SetAllFolder">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                    Todos os Arquivos
                </button>
                <button class="w-full flex items-center gap-2 px-3 py-2 text-sm rounded-lg @(currentFolder == "documents" ? "bg-[var(--primary)] text-white" : "hover:bg-[var(--muted)]")" @onclick="SetDocumentsFolder">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Documentos
                </button>
                <button class="w-full flex items-center gap-2 px-3 py-2 text-sm rounded-lg @(currentFolder == "images" ? "bg-[var(--primary)] text-white" : "hover:bg-[var(--muted)]")" @onclick="SetImagesFolder">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    Imagens
                </button>
                <button class="w-full flex items-center gap-2 px-3 py-2 text-sm rounded-lg @(currentFolder == "videos" ? "bg-[var(--primary)] text-white" : "hover:bg-[var(--muted)]")" @onclick="SetVideosFolder">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    Vídeos
                </button>
                <button class="w-full flex items-center gap-2 px-3 py-2 text-sm rounded-lg @(currentFolder == "trash" ? "bg-[var(--primary)] text-white" : "hover:bg-[var(--muted)]")" @onclick="SetTrashFolder">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    Lixeira
                </button>
            </nav>
            <div class="mt-6 p-4 bg-[var(--muted)] rounded-lg">
                <p class="text-sm font-medium mb-2">Armazenamento</p>
                <div class="h-2 bg-[var(--secondary)] rounded-full overflow-hidden mb-2">
                    <div class="h-full bg-[var(--primary)] rounded-full" style="width: 65%"></div>
                </div>
                <p class="text-xs text-[var(--muted-foreground)]">6.5 GB de 10 GB usados</p>
            </div>
        </div>
    </Card>

    <div class="lg:col-span-3">
        <Card>
            <div class="p-4 border-b border-[var(--border)] flex items-center gap-4">
                <input class="flex-1 px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="Buscar arquivos..." @bind="searchTerm" />
                <div class="flex gap-1">
                    <button class="p-2 rounded @(viewMode == "grid" ? "bg-[var(--muted)]" : "hover:bg-[var(--muted)]")" @onclick="SetGridView">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                    </button>
                    <button class="p-2 rounded @(viewMode == "list" ? "bg-[var(--muted)]" : "hover:bg-[var(--muted)]")" @onclick="SetListView">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                    </button>
                </div>
            </div>

            @if (viewMode == "grid")
            {
                <div class="p-4 grid grid-cols-2 md:grid-cols-4 gap-4">
                    @foreach (var file in filteredFiles)
                    {
                        <div class="p-4 border border-[var(--border)] rounded-lg hover:border-[var(--primary)] cursor-pointer transition-colors">
                            <div class="text-4xl mb-3 text-center">@file.Icon</div>
                            <p class="text-sm font-medium truncate">@file.Name</p>
                            <p class="text-xs text-[var(--muted-foreground)]">@file.Size</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-[var(--border)]">
                            <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Nome</th>
                            <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Tamanho</th>
                            <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Modificado</th>
                            <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var file in filteredFiles)
                        {
                            <tr class="border-b border-[var(--border)] hover:bg-[var(--muted)]">
                                <td class="p-4">
                                    <div class="flex items-center gap-3">
                                        <span class="text-2xl">@file.Icon</span>
                                        <span class="font-medium">@file.Name</span>
                                    </div>
                                </td>
                                <td class="p-4 text-sm text-[var(--muted-foreground)]">@file.Size</td>
                                <td class="p-4 text-sm text-[var(--muted-foreground)]">@file.Modified</td>
                                <td class="p-4">
                                    <button class="text-[var(--muted-foreground)] hover:text-[var(--foreground)]">Baixar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </Card>
    </div>
</div>
@code {
    private string currentFolder = "all";
    private string searchTerm = "";
    private string viewMode = "grid";

    private List<FileItem> files = new()
    {
        new("📁", "Recursos do Projeto", "Folder", "--", "há 2 horas", "documents"),
        new("📄", "Relatório Anual.pdf", "2.4 MB", "PDF", "há 1 dia", "documents"),
        new("🖼️", "Mockup do Dashboard.png", "1.8 MB", "Image", "há 3 dias", "images"),
        new("📊", "Receita Q3.xlsx", "856 KB", "Spreadsheet", "há 1 semana", "documents"),
        new("🎬", "Demo do Produto.mp4", "48.2 MB", "Video", "há 2 semanas", "videos"),
        new("📄", "Ata de Reunião.docx", "124 KB", "Document", "há 3 dias", "documents"),
        new("🖼️", "Foto da Equipe.jpg", "3.2 MB", "Image", "há 1 mês", "images"),
        new("📁", "Arquivos de Clientes", "Folder", "--", "há 5 dias", "documents"),
        new("📄", "Modelo de Fatura.pdf", "420 KB", "PDF", "há 2 semanas", "documents"),
        new("🖼️", "Design do Logo.svg", "56 KB", "Image", "há 1 mês", "images")
    };

    private IEnumerable<FileItem> filteredFiles => files
        .Where(f => (currentFolder == "all" || f.Category == currentFolder) &&
                     (string.IsNullOrEmpty(searchTerm) || f.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private void SetFolder(string folder) { currentFolder = folder; }
    private void SetAllFolder() { currentFolder = "all"; }
    private void SetDocumentsFolder() { currentFolder = "documents"; }
    private void SetImagesFolder() { currentFolder = "images"; }
    private void SetVideosFolder() { currentFolder = "videos"; }
    private void SetTrashFolder() { currentFolder = "trash"; }
    private void SetGridView() { viewMode = "grid"; }
    private void SetListView() { viewMode = "list"; }

    public record FileItem(string Icon, string Name, string Size, string Type, string Modified, string Category);
}
