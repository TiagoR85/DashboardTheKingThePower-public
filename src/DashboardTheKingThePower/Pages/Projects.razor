@page "/projects"
@using DashboardTheKingThePower.Components.ui
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Projetos</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Projetos</h1>
    <Button OnClick="ShowCreateModal">+ Novo Projeto</Button>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Total de Projetos</p>
            <p class="text-2xl font-bold mt-1">@projects.Count</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Ativo</p>
            <p class="text-2xl font-bold mt-1 text-green-500">@projects.Count(p => p.Status == "Active")</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Concluído</p>
            <p class="text-2xl font-bold mt-1 text-blue-500">@projects.Count(p => p.Status == "Completed")</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Pausado</p>
            <p class="text-2xl font-bold mt-1 text-yellow-500">@projects.Count(p => p.Status == "On Hold")</p>
        </div>
    </Card>
</div>

<Card>
    <div class="p-4 border-b border-[var(--border)] flex items-center gap-4">
        <input class="flex-1 px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="Buscar projetos..." @bind="searchTerm" />
        <select class="px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="filterStatus">
            <option value="all">Todos os Status</option>
            <option value="active">Ativo</option>
            <option value="completed">Concluído</option>
            <option value="on hold">Pausado</option>
            <option value="planning">Planejamento</option>
        </select>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-[var(--border)]">
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">ID</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Nome</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Cliente</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Status</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Progresso</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Data de Início</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Data de Término</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Orçamento</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in filteredProjects)
                {
                    @if (editingId == project.Id)
                    {
                        <tr class="border-b border-[var(--border)] bg-[var(--muted)]">
                            <td class="p-4 font-medium">@project.Id</td>
                            <td class="p-4"><input class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editModel.Name" /></td>
                            <td class="p-4"><input class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editModel.Client" /></td>
                            <td class="p-4">
                                <select class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editModel.Status">
                                    <option value="Active">Ativo</option>
                                    <option value="Completed">Concluído</option>
                                    <option value="On Hold">Pausado</option>
                                    <option value="Planning">Planejamento</option>
                                </select>
                            </td>
                            <td class="p-4"><input type="number" min="0" max="100" class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editModel.Progress" /></td>
                            <td class="p-4"><input type="date" class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editModel.StartDate" /></td>
                            <td class="p-4"><input type="date" class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editModel.EndDate" /></td>
                            <td class="p-4"><input type="number" class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editModel.Budget" /></td>
                            <td class="p-4">
                                <button class="text-green-500 hover:text-green-700 mr-2 text-sm" @onclick="SaveEdit">Salvar</button>
                                <button class="text-[var(--muted-foreground)] hover:text-[var(--foreground)] text-sm" @onclick="CancelEdit">Cancelar</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="border-b border-[var(--border)] hover:bg-[var(--muted)]">
                            <td class="p-4 font-medium">@project.Id</td>
                            <td class="p-4 font-medium">@project.Name</td>
                            <td class="p-4">@project.Client</td>
                            <td class="p-4">
                                <span class="text-xs px-2 py-1 rounded-full text-white" style="background-color: @GetStatusColor(project.Status);">@project.Status</span>
                            </td>
                            <td class="p-4">
                                <div class="flex items-center gap-2">
                                    <div class="flex-1 h-2 rounded-full bg-[var(--muted)]">
                                        <div class="h-2 rounded-full transition-all" style="width: @(project.Progress)%; background-color: @GetProgressColor(project.Progress);"></div>
                                    </div>
                                    <span class="text-xs text-[var(--muted-foreground)] w-8 text-right">@project.Progress%</span>
                                </div>
                            </td>
                            <td class="p-4 text-sm text-[var(--muted-foreground)]">@project.StartDate.ToString("MMM dd, yyyy")</td>
                            <td class="p-4 text-sm text-[var(--muted-foreground)]">@project.EndDate.ToString("MMM dd, yyyy")</td>
                            <td class="p-4 font-medium">$@project.Budget.ToString("N0")</td>
                            <td class="p-4">
                                <button class="text-[var(--muted-foreground)] hover:text-[var(--foreground)] mr-2 text-sm" @onclick="() => StartEdit(project)">Editar</button>
                                <button class="text-red-500 hover:text-red-700 text-sm" @onclick="() => ConfirmDelete(project)">Excluir</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</Card>

@if (showDeleteConfirm)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
        <Card Class="w-96">
            <div class="p-6">
                <h2 class="text-lg font-bold mb-2">Excluir Projeto</h2>
                <p class="text-sm text-[var(--muted-foreground)]">Tem certeza de que deseja excluir <strong>@deletingProject?.Name</strong>? Esta ação não pode ser desfeita.</p>
                <div class="flex justify-end gap-3 mt-6">
                    <Button Variant="secondary" OnClick="CancelDelete">Cancelar</Button>
                    <Button OnClick="DeleteProject">Excluir</Button>
                </div>
            </div>
        </Card>
    </div>
}

@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
        <Card Class="w-[500px]">
            <div class="p-6">
                <h2 class="text-lg font-bold mb-4">Novo Projeto</h2>
                <div class="space-y-3">
                    <div>
                        <label class="text-sm font-medium text-[var(--muted-foreground)]">Nome</label>
                        <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm mt-1" @bind="newProject.Name" />
                    </div>
                    <div>
                        <label class="text-sm font-medium text-[var(--muted-foreground)]">Cliente</label>
                        <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm mt-1" @bind="newProject.Client" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-sm font-medium text-[var(--muted-foreground)]">Status</label>
                            <select class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm mt-1" @bind="newProject.Status">
                                <option value="Planning">Planejamento</option>
                                <option value="Active">Ativo</option>
                                <option value="Completed">Concluído</option>
                                <option value="On Hold">Pausado</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-sm font-medium text-[var(--muted-foreground)]">Orçamento ($)</label>
                            <input type="number" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm mt-1" @bind="newProject.Budget" />
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-sm font-medium text-[var(--muted-foreground)]">Data de Início</label>
                            <input type="date" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm mt-1" @bind="newProject.StartDate" />
                        </div>
                        <div>
                            <label class="text-sm font-medium text-[var(--muted-foreground)]">Data de Término</label>
                            <input type="date" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm mt-1" @bind="newProject.EndDate" />
                        </div>
                    </div>
                </div>
                <div class="flex justify-end gap-3 mt-6">
                    <Button Variant="secondary" OnClick="CancelCreate">Cancelar</Button>
                    <Button OnClick="CreateProject">Criar</Button>
                </div>
            </div>
        </Card>
    </div>
}
@code {
    private string searchTerm = "";
    private string filterStatus = "all";
    private string? editingId;
    private bool showDeleteConfirm;
    private bool showCreateModal;
    private Project? deletingProject;

    private ProjectEditModel editModel = new();
    private ProjectCreateModel newProject = new();

    private List<Project> projects = new()
    {
        new("PRJ-001", "Website Redesign", "Acme Corp", "Active", 65, new DateTime(2026, 6, 1), new DateTime(2026, 9, 30), 45000),
        new("PRJ-002", "Mobile App Development", "TechStart", "Active", 40, new DateTime(2026, 7, 15), new DateTime(2026, 12, 20), 120000),
        new("PRJ-003", "API Integration", "Global Inc", "Completed", 100, new DateTime(2026, 3, 1), new DateTime(2026, 6, 30), 28000),
        new("PRJ-004", "Data Migration", "Creative Co", "On Hold", 25, new DateTime(2026, 5, 10), new DateTime(2026, 10, 15), 35000),
        new("PRJ-005", "Cloud Infrastructure", "Future Labs", "Active", 55, new DateTime(2026, 4, 20), new DateTime(2026, 11, 30), 85000),
        new("PRJ-006", "E-commerce Platform", "Acme Corp", "Planning", 0, new DateTime(2026, 9, 1), new DateTime(2027, 3, 31), 95000),
        new("PRJ-007", "Analytics Dashboard", "TechStart", "Active", 80, new DateTime(2026, 5, 1), new DateTime(2026, 8, 31), 42000),
        new("PRJ-008", "Security Audit", "Global Inc", "Completed", 100, new DateTime(2026, 4, 15), new DateTime(2026, 7, 15), 18000),
        new("PRJ-009", "CRM Integration", "Creative Co", "Active", 30, new DateTime(2026, 8, 1), new DateTime(2027, 1, 31), 62000),
        new("PRJ-010", "Performance Optimization", "Future Labs", "Planning", 0, new DateTime(2026, 10, 1), new DateTime(2027, 2, 28), 37000)
    };

    private IEnumerable<Project> filteredProjects => projects
        .Where(p => (filterStatus == "all" || p.Status.ToLower() == filterStatus) &&
                     (string.IsNullOrEmpty(searchTerm) || p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || p.Client.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || p.Id.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private string GetStatusColor(string status) => status switch
    {
        "Active" => "#10b981",
        "Completed" => "#3b82f6",
        "On Hold" => "#f59e0b",
        "Planning" => "#6b7280",
        _ => "#6b7280"
    };

    private string GetProgressColor(int progress) => progress switch
    {
        100 => "#3b82f6",
        >= 75 => "#10b981",
        >= 50 => "#f59e0b",
        >= 25 => "#f97316",
        _ => "#ef4444"
    };

    private void ShowCreateModal()
    {
        newProject = new ProjectCreateModel
        {
            Status = "Planning",
            StartDate = DateTime.Today,
            EndDate = DateTime.Today.AddMonths(6)
        };
        showCreateModal = true;
    }

    private void CancelCreate() => showCreateModal = false;

    private void CreateProject()
    {
        var id = $"PRJ-{projects.Count + 1:D3}";
        projects.Add(new(id, newProject.Name, newProject.Client, newProject.Status, 0, newProject.StartDate, newProject.EndDate, newProject.Budget));
        showCreateModal = false;
    }

    private void StartEdit(Project project)
    {
        editingId = project.Id;
        editModel = new ProjectEditModel
        {
            Name = project.Name,
            Client = project.Client,
            Status = project.Status,
            Progress = project.Progress,
            StartDate = project.StartDate,
            EndDate = project.EndDate,
            Budget = project.Budget
        };
    }

    private void SaveEdit()
    {
        if (editingId == null) return;
        var index = projects.FindIndex(p => p.Id == editingId);
        if (index >= 0)
        {
            projects[index] = projects[index] with
            {
                Name = editModel.Name,
                Client = editModel.Client,
                Status = editModel.Status,
                Progress = editModel.Progress,
                StartDate = editModel.StartDate,
                EndDate = editModel.EndDate,
                Budget = editModel.Budget
            };
        }
        editingId = null;
    }

    private void CancelEdit() => editingId = null;

    private void ConfirmDelete(Project project)
    {
        deletingProject = project;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        deletingProject = null;
        showDeleteConfirm = false;
    }

    private void DeleteProject()
    {
        if (deletingProject != null)
        {
            projects.Remove(deletingProject);
        }
        deletingProject = null;
        showDeleteConfirm = false;
    }

    public record Project(string Id, string Name, string Client, string Status, int Progress, DateTime StartDate, DateTime EndDate, decimal Budget);

    public class ProjectEditModel
    {
        public string Name { get; set; } = "";
        public string Client { get; set; } = "";
        public string Status { get; set; } = "";
        public int Progress { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public decimal Budget { get; set; }
    }

    public class ProjectCreateModel
    {
        public string Name { get; set; } = "";
        public string Client { get; set; } = "";
        public string Status { get; set; } = "Planning";
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public decimal Budget { get; set; }
    }
}
