@page "/orders"
@using DashboardTheKingThePower.Components.ui
@using DashboardTheKingThePower.Models
@using DashboardTheKingThePower.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject OrderService OrderService

<PageTitle>Pedidos</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Pedidos</h1>
    <Button OnClick="ShowCreateModal">+ Novo Pedido</Button>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Total de Pedidos</p>
            <p class="text-2xl font-bold mt-1">@orders.Count</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Receita</p>
            <p class="text-2xl font-bold mt-1">$@orders.Sum(o => o.Total).ToString("N2")</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Pendentes</p>
            <p class="text-2xl font-bold mt-1 text-yellow-500">@orders.Count(o => IsPending(o.Status))</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Entregues</p>
            <p class="text-2xl font-bold mt-1 text-green-500">@orders.Count(o => o.Status == "Delivered")</p>
        </div>
    </Card>
</div>

<Card>
    <div class="p-4 border-b border-[var(--border)] flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <input class="flex-1 w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="Buscar pedidos..." @bind="searchTerm" @bind:event="oninput" />
        <select class="px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="filterStatus">
            <option value="all">Todos os Status</option>
            <option value="Pending">Pendente</option>
            <option value="Processing">Em Processamento</option>
            <option value="Shipped">Enviado</option>
            <option value="Delivered">Entregue</option>
            <option value="Cancelled">Cancelado</option>
        </select>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-[var(--border)]">
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">ID do Pedido</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Cliente</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Data</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Total</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Status</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in filteredOrders)
                {
                    <tr class="border-b border-[var(--border)] hover:bg-[var(--muted)]">
                        <td class="p-4"><a href="orders/@order.Id" class="font-medium text-[var(--primary)] hover:underline">@order.Id</a></td>
                        <td class="p-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs" style="background-color: @AvatarColor(order.Customer)">
                                    @order.Customer.Split(' ').Select(n => n[0].ToString()).Aggregate("", (a, b) => a + b)
                                </div>
                                <span class="text-sm font-medium">@order.Customer</span>
                            </div>
                        </td>
                        <td class="p-4 text-sm text-[var(--muted-foreground)]">@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="p-4 font-medium">$@order.Total.ToString("N2")</td>
                        <td class="p-4">
                            <Badge Variant="@StatusBadgeVariant(order.Status)">@order.Status</Badge>
                        </td>
                        <td class="p-4">
                            <button class="text-[var(--muted-foreground)] hover:text-[var(--foreground)] mr-2" @onclick="() => StartEdit(order)">Editar</button>
                            <button class="text-[var(--muted-foreground)] hover:text-red-500" @onclick="() => ConfirmDelete(order)">Excluir</button>
                        </td>
                    </tr>
                }
                @if (!filteredOrders.Any())
                {
                    <tr>
                        <td colspan="6" class="p-8 text-center text-[var(--muted-foreground)]">Nenhum pedido encontrado com os critérios informados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</Card>

@if (showEditModal)
{
    <Modal IsOpen="true" OnClose="CloseEditModal">
        <div class="p-6">
            <h2 class="text-lg font-semibold mb-4">@(editingOrder == null ? "Novo Pedido" : "Editar Pedido")</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1">Cliente</label>
                    <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" @bind="editCustomer" placeholder="Nome do cliente" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Data</label>
                        <input type="date" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" @bind="editDate" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Total ($)</label>
                        <input type="number" step="0.01" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" @bind="editTotal" placeholder="0.00" />
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Status</label>
                    <select class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" @bind="editStatus">
                        <option value="Pending">Pendente</option>
                        <option value="Processing">Em Processamento</option>
                        <option value="Shipped">Enviado</option>
                        <option value="Delivered">Entregue</option>
                        <option value="Cancelled">Cancelado</option>
                    </select>
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-6">
                <button class="px-4 py-2 text-sm rounded-lg border border-[var(--border)] hover:bg-[var(--secondary)]" @onclick="CloseEditModal">Cancelar</button>
                <button class="px-4 py-2 text-sm rounded-lg bg-[var(--primary)] text-white hover:opacity-90" @onclick="SaveOrder">Salvar</button>
            </div>
        </div>
    </Modal>
}

@if (showDeleteModal)
{
    <Modal IsOpen="true" OnClose="CloseDeleteModal">
        <div class="p-6">
            <h2 class="text-lg font-semibold mb-2">Excluir Pedido</h2>
            <p class="text-sm text-[var(--muted-foreground)] mb-6">Tem certeza de que deseja excluir o pedido <strong>@deletingOrder?.Id</strong> de <strong>@deletingOrder?.Customer</strong>? Esta ação não pode ser desfeita.</p>
            <div class="flex justify-end gap-2">
                <button class="px-4 py-2 text-sm rounded-lg border border-[var(--border)] hover:bg-[var(--secondary)]" @onclick="CloseDeleteModal">Cancelar</button>
                <button class="px-4 py-2 text-sm rounded-lg bg-red-500 text-white hover:bg-red-600" @onclick="DeleteOrder">Excluir</button>
            </div>
        </div>
    </Modal>
}
@code {
    private string searchTerm = "";
    private string filterStatus = "all";
    private bool showEditModal = false;
    private bool showDeleteModal = false;

    private PlacedOrder? editingOrder = null;
    private PlacedOrder? deletingOrder = null;

    private string editCustomer = "";
    private DateOnly editDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal editTotal = 0;
    private string editStatus = "Pending";

    private static readonly string[] customerColors = new[] { "#3b82f6", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899", "#06b6d4", "#f97316" };

    // Status vêm mistos no storage (mesma mistura tratada por OrderDetail.StatusIndex):
    // seed em EN ("Pending") e checkout em PT-BR ("Pendente"). KPI e filtro reconhecem ambos.
    private static bool IsPending(string status) => status is "Pending" or "Pendente";

    // PlacedOrder não tem campo Color: cor do avatar derivada de forma determinística do nome
    private static string AvatarColor(string customer)
    {
        var hash = customer.Sum(c => (int)c);
        return customerColors[hash % customerColors.Length];
    }

    private static string StatusBadgeVariant(string status) => status switch
    {
        "Delivered" => "success",
        "Shipped" => "warning",
        "Cancelled" => "error",
        _ => "default"
    };

    private List<PlacedOrder> orders = new();

    protected override async Task OnInitializedAsync() => orders = await OrderService.GetAsync();

    private IEnumerable<PlacedOrder> filteredOrders => orders
        .Where(o => (filterStatus == "all" ||
                     (filterStatus == "Pending" ? IsPending(o.Status) : o.Status == filterStatus)) &&
                     (string.IsNullOrEmpty(searchTerm) ||
                      o.Customer.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                      o.Id.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private void ShowCreateModal()
    {
        editingOrder = null;
        editCustomer = "";
        editDate = DateOnly.FromDateTime(DateTime.Today);
        editTotal = 0;
        editStatus = "Pending";
        showEditModal = true;
    }

    private void StartEdit(PlacedOrder order)
    {
        editingOrder = order;
        editCustomer = order.Customer;
        editDate = DateOnly.FromDateTime(order.CreatedAt);
        editTotal = order.Total;
        // Vocabulário desta página é EN: normaliza "Pendente"→"Pending" na abertura do
        // modal para o <select> exibir/salvar a opção correta. OrderDetail.StatusIndex
        // aceita os dois ("Pending" e "Pendente" → passo "Pendente"), então o detalhe
        // continua íntegro. É o único status PT em uso (OrderService.Build); cancelar
        // não altera o pedido (só editStatus é alterado aqui, não order.Status).
        editStatus = order.Status == "Pendente" ? "Pending" : order.Status;
        showEditModal = true;
    }

    private void CloseEditModal() { showEditModal = false; editingOrder = null; }

    private async Task SaveOrder()
    {
        if (string.IsNullOrWhiteSpace(editCustomer) || editTotal <= 0) return;

        if (editingOrder == null)
        {
            var nextId = orders.Count == 0 ? 1 : orders.Max(o => int.Parse(o.Id.Split('-')[1])) + 1;
            orders.Add(new PlacedOrder
            {
                Id = $"ORD-{nextId:D3}",
                Customer = editCustomer,
                CreatedAt = editDate.ToDateTime(TimeOnly.MinValue),
                Subtotal = editTotal,
                Frete = 0m,
                Total = editTotal,
                Status = editStatus,
                Items = new()
            });
        }
        else
        {
            editingOrder.Customer = editCustomer;
            editingOrder.CreatedAt = editDate.ToDateTime(TimeOnly.MinValue);
            editingOrder.Subtotal = editTotal;
            editingOrder.Frete = 0m; // Subtotal=Total ⟹ Frete=0 (espelha o branch de criação)
            editingOrder.Total = editTotal;
            editingOrder.Status = editStatus;
        }
        CloseEditModal();
        await OrderService.SaveAsync(orders);
    }

    private void ConfirmDelete(PlacedOrder order)
    {
        deletingOrder = order;
        showDeleteModal = true;
    }

    private void CloseDeleteModal() { showDeleteModal = false; deletingOrder = null; }

    private async Task DeleteOrder()
    {
        if (deletingOrder != null)
        {
            orders.Remove(deletingOrder);
            CloseDeleteModal();
            await OrderService.SaveAsync(orders);
        }
    }
}
