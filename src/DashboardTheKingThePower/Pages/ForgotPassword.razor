@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@using DashboardTheKingThePower.Components.ui
@using DashboardTheKingThePower.Services
@using Microsoft.AspNetCore.Authorization
@inject UserService UserService
@inject NavigationManager Navigation

<PageTitle>Esqueceu a senha</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-[var(--background)] p-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <div class="w-12 h-12 rounded-xl bg-[var(--primary)] flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold">Esqueceu a senha?</h1>
            <p class="text-[var(--muted-foreground)] mt-1">Digite seu e-mail para redefinir a senha</p>
        </div>

        <Card>
            <div class="p-6">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="mb-4 p-3 bg-red-500/10 border border-red-500/20 rounded-lg text-red-500 text-sm">
                        @_errorMessage
                    </div>
                }
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="mb-4 p-3 bg-green-500/10 border border-green-500/20 rounded-lg text-green-500 text-sm">
                        @_successMessage
                    </div>
                }
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">E-mail</label>
                        <input type="email" @bind="_email" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" placeholder="you@example.com" />
                    </div>
                    <button @onclick="HandleResetPassword" disabled="@_isLoading" class="w-full py-2 bg-[var(--primary)] text-white rounded-lg hover:opacity-90 disabled:opacity-50">
                        @if (_isLoading)
                        {
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <span>Enviar link de redefinição</span>
                        }
                    </button>
                </div>
                <div class="mt-6 text-center text-sm">
                    <a href="login" class="text-[var(--primary)] hover:underline">Voltar ao login</a>
                </div>
            </div>
        </Card>
    </div>
</div>

@code {
    private string _email = "";
    private bool _isLoading;
    private string? _errorMessage;
    private string? _successMessage;

    private async Task HandleResetPassword()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        if (string.IsNullOrWhiteSpace(_email))
        {
            _errorMessage = "Informe seu endereço de e-mail.";
            _isLoading = false;
            return;
        }

        try
        {
            var emailExists = await UserService.EmailExistsAsync(_email);
            if (!emailExists)
            {
                _errorMessage = "Nenhuma conta encontrada com este endereço de e-mail.";
                _isLoading = false;
                return;
            }

            _successMessage = "O link de redefinição de senha foi enviado para o seu endereço de e-mail.";
            _email = "";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
