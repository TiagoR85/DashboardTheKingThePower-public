@page "/settings"
@using DashboardTheKingThePower.Components.ui
@using DashboardTheKingThePower.Components.theme
@using DashboardTheKingThePower.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthStateProvider AuthStateProvider
@inject UserService UserService
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Configurações</PageTitle>

<h1 class="text-2xl font-bold mb-6">Configurações</h1>

<div class="flex gap-2 mb-6">
    <button class="px-4 py-2 text-sm rounded-lg @(activeTab == "profile" ? "bg-[var(--primary)] text-white" : "border border-[var(--border)] hover:bg-[var(--secondary)]")" @onclick="SetProfileTab">Perfil</button>
    <button class="px-4 py-2 text-sm rounded-lg @(activeTab == "notifications" ? "bg-[var(--primary)] text-white" : "border border-[var(--border)] hover:bg-[var(--secondary)]")" @onclick="SetNotificationsTab">Notificações</button>
    <button class="px-4 py-2 text-sm rounded-lg @(activeTab == "security" ? "bg-[var(--primary)] text-white" : "border border-[var(--border)] hover:bg-[var(--secondary)]")" @onclick="SetSecurityTab">Segurança</button>
    <button class="px-4 py-2 text-sm rounded-lg @(activeTab == "appearance" ? "bg-[var(--primary)] text-white" : "border border-[var(--border)] hover:bg-[var(--secondary)]")" @onclick="SetAppearanceTab">Aparência</button>
</div>

@if (activeTab == "profile")
{
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <Card>
            <div class="p-6 text-center">
                <div class="w-24 h-24 rounded-full bg-[var(--primary)] flex items-center justify-center text-white text-3xl font-bold mx-auto mb-4">
                    @_profileInitials
                </div>
                <h3 class="font-semibold text-lg">@_profileName</h3>
                <p class="text-[var(--muted-foreground)]">@_profileRole</p>
                <button class="mt-4 px-4 py-2 text-sm border border-[var(--border)] rounded-lg hover:bg-[var(--muted)]">Alterar avatar</button>
            </div>
        </Card>
        <div class="lg:col-span-2">
            <Card>
                <div class="p-6">
                    <h3 class="font-semibold mb-4">Informações pessoais</h3>
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium mb-1">Nome</label>
                                <input @bind="_profileFirstName" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1">Sobrenome</label>
                                <input @bind="_profileLastName" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" />
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">E-mail</label>
                            <input type="email" @bind="_profileEmail" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" disabled />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Bio</label>
                            <textarea @bind="_profileBio" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] h-20"></textarea>
                        </div>
                        @if (!string.IsNullOrEmpty(_profileMessage))
                        {
                            <div class="p-3 bg-green-500/10 border border-green-500/20 rounded-lg text-green-500 text-sm">
                                @_profileMessage
                            </div>
                        }
                        <div class="flex justify-end">
                            <button @onclick="SaveProfile" class="px-4 py-2 bg-[var(--primary)] text-white text-sm rounded-lg hover:opacity-90">Salvar alterações</button>
                        </div>
                    </div>
                </div>
            </Card>
        </div>
    </div>
}
else if (activeTab == "notifications")
{
    <Card>
        <div class="p-6">
            <h3 class="font-semibold mb-4">Preferências de notificações</h3>
            <div class="space-y-6">
                @foreach (var setting in notificationSettings)
                {
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-medium">@setting.Name</p>
                            <p class="text-sm text-[var(--muted-foreground)]">@setting.Description</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" checked="@setting.Enabled" class="sr-only peer" />
                            <div class="w-11 h-6 bg-[var(--muted)] peer-focus:ring-2 peer-focus:ring-[var(--primary)] rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--primary)]"></div>
                        </label>
                    </div>
                }
            </div>
        </div>
    </Card>
}
else if (activeTab == "security")
{
    <div class="space-y-6">
        <Card>
            <div class="p-6">
                <h3 class="font-semibold mb-4">Alterar senha</h3>
                @if (!string.IsNullOrEmpty(_passwordMessage))
                {
                    <div class="mb-4 p-3 @(isPasswordSuccess ? "bg-green-500/10 border border-green-500/20 text-green-500" : "bg-red-500/10 border border-red-500/20 text-red-500") text-sm rounded-lg">
                        @_passwordMessage
                    </div>
                }
                <div class="space-y-4 max-w-md">
                    <div>
                        <label class="block text-sm font-medium mb-1">Senha atual</label>
                        <input type="password" @bind="_currentPassword" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Nova senha</label>
                        <input type="password" @bind="_newPassword" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Confirmar nova senha</label>
                        <input type="password" @bind="_confirmNewPassword" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" />
                    </div>
                    <button @onclick="HandlePasswordChange" disabled="@_isPasswordLoading" class="px-4 py-2 bg-[var(--primary)] text-white text-sm rounded-lg hover:opacity-90 disabled:opacity-50">
                        @if (_isPasswordLoading)
                        {
                            <span>Atualizando...</span>
                        }
                        else
                        {
                            <span>Atualizar senha</span>
                        }
                    </button>
                </div>
            </div>
        </Card>
        <Card>
            <div class="p-6">
                <h3 class="font-semibold mb-4">Autenticação de dois fatores</h3>
                <p class="text-[var(--muted-foreground)] mb-4">Adicione uma camada extra de segurança à sua conta.</p>
                <button class="px-4 py-2 border border-[var(--border)] text-sm rounded-lg hover:bg-[var(--muted)]">Ativar 2FA</button>
            </div>
        </Card>
        <Card>
            <div class="p-6">
                <h3 class="font-semibold mb-4">Sessões ativas</h3>
                <div class="space-y-3">
                    <div class="flex items-center justify-between p-3 border border-[var(--border)] rounded-lg">
                        <div>
                            <p class="font-medium">Sessão atual</p>
                            <p class="text-sm text-[var(--muted-foreground)]">Ativo agora</p>
                        </div>
                        <span class="text-xs px-2 py-1 bg-green-100 text-green-700 rounded-full">Atual</span>
                    </div>
                </div>
            </div>
        </Card>
    </div>
}
else if (activeTab == "appearance")
{
    <div class="space-y-6">
        <Card>
            <div class="p-6">
                <h3 class="font-semibold mb-4">Tema</h3>
                <div class="flex gap-4">
                    <ThemeToggle />
                </div>
            </div>
        </Card>
        <Card>
            <div class="p-6">
                <h3 class="font-semibold mb-4">Cor de destaque</h3>
                <AccentPicker />
            </div>
        </Card>
        <Card>
            <div class="p-6">
                <h3 class="font-semibold mb-4">Sidebar</h3>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium">Recolhida por padrão</p>
                        <p class="text-sm text-[var(--muted-foreground)]">Iniciar com a sidebar recolhida</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" class="sr-only peer" />
                        <div class="w-11 h-6 bg-[var(--muted)] peer-focus:ring-2 peer-focus:ring-[var(--primary)] rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--primary)]"></div>
                    </label>
                </div>
            </div>
        </Card>
    </div>
}
@code {
    private string activeTab = "profile";
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmNewPassword = "";
    private bool _isPasswordLoading;
    private string? _passwordMessage;
    private bool isPasswordSuccess;

    private string _profileName = "";
    private string _profileFirstName = "";
    private string _profileLastName = "";
    private string _profileEmail = "";
    private string _profileRole = "";
    private string _profileBio = "";
    private string _profileInitials = "U";
    private string? _profileMessage;

    private List<NotificationSetting> notificationSettings = new()
    {
        new("Notificações por e-mail", "Receber e-mail para novas mensagens", true),
        new("Notificações push", "Receber notificações push", true),
        new("Resumo semanal", "Receber e-mail com resumo semanal", false),
        new("E-mails de marketing", "Receber novidades de produtos", false)
    };

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthStateProvider.GetCurrentUserAsync();
        if (user != null)
        {
            _profileName = user.Name;
            _profileEmail = user.Email;
            _profileRole = user.Role;
            var nameParts = user.Name.Split(' ', 2);
            _profileFirstName = nameParts.Length > 0 ? nameParts[0] : "";
            _profileLastName = nameParts.Length > 1 ? nameParts[1] : "";
            _profileInitials = string.Concat(user.Name.Split(' ').Select(n => n[0].ToString())).ToUpper();
            if (_profileInitials.Length > 2) _profileInitials = _profileInitials.Substring(0, 2);
        }
    }

    private void SetProfileTab() { activeTab = "profile"; }
    private void SetNotificationsTab() { activeTab = "notifications"; }
    private void SetSecurityTab() { activeTab = "security"; }
    private void SetAppearanceTab() { activeTab = "appearance"; }

    private async Task SaveProfile()
    {
        _profileMessage = null;
        var name = $"{_profileFirstName} {_profileLastName}".Trim();
        if (!string.IsNullOrWhiteSpace(name))
        {
            _profileName = name;
            _profileInitials = string.Concat(name.Split(' ').Select(n => n[0].ToString())).ToUpper();
            if (_profileInitials.Length > 2) _profileInitials = _profileInitials.Substring(0, 2);
        }
        _profileMessage = "Perfil atualizado com sucesso!";
        await Task.Delay(2000);
        _profileMessage = null;
    }

    private async Task HandlePasswordChange()
    {
        _isPasswordLoading = true;
        _passwordMessage = null;

        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _passwordMessage = "Preencha todos os campos de senha.";
            isPasswordSuccess = false;
            _isPasswordLoading = false;
            return;
        }

        if (_newPassword != _confirmNewPassword)
        {
            _passwordMessage = "As novas senhas não coincidem.";
            isPasswordSuccess = false;
            _isPasswordLoading = false;
            return;
        }

        if (_newPassword.Length < 6)
        {
            _passwordMessage = "A nova senha deve ter pelo menos 6 caracteres.";
            isPasswordSuccess = false;
            _isPasswordLoading = false;
            return;
        }

        try
        {
            var user = await AuthStateProvider.GetCurrentUserAsync();
            if (user == null)
            {
                _passwordMessage = "Você precisa estar logado para alterar sua senha.";
                isPasswordSuccess = false;
                _isPasswordLoading = false;
                return;
            }

            var success = await UserService.UpdatePasswordAsync(user.Email, _currentPassword, _newPassword);
            if (success)
            {
                _passwordMessage = "Senha atualizada com sucesso!";
                isPasswordSuccess = true;
                _currentPassword = "";
                _newPassword = "";
                _confirmNewPassword = "";
            }
            else
            {
                _passwordMessage = "A senha atual está incorreta.";
                isPasswordSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _passwordMessage = ex.Message;
            isPasswordSuccess = false;
        }
        finally
        {
            _isPasswordLoading = false;
        }
    }

    public record NotificationSetting(string Name, string Description, bool Enabled);
}
