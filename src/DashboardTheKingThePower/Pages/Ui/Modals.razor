@page "/ui/modals"
@using DashboardTheKingThePower.Components.ui
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Modals</PageTitle>

<h1 class="text-2xl font-bold mb-1">Modals</h1>
<p class="text-sm text-[var(--muted-foreground)] mb-6">Diálogos sobrepostos — confirmação e formulário.</p>

<Button OnClick="() => _open = true">Abrir modal</Button>

@if (_open)
{
    <Modal IsOpen="true" OnClose="() => _open = false">
        <div class="p-6">
            <h2 class="text-lg font-semibold mb-2">Exemplo de modal</h2>
            <p class="text-sm text-[var(--muted-foreground)] mb-4">O fundo escurece e o clique fora fecha o diálogo.</p>
            <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="Um campo de exemplo" />
            <div class="flex justify-end gap-2 mt-6">
                <button class="px-4 py-2 text-sm rounded-lg border border-[var(--border)] hover:bg-[var(--secondary)]" @onclick="() => _open = false">Cancelar</button>
                <button class="px-4 py-2 text-sm rounded-lg bg-[var(--primary)] text-white hover:opacity-90" @onclick="() => _open = false">Confirmar</button>
            </div>
        </div>
    </Modal>
}

@code { private bool _open = false; }
