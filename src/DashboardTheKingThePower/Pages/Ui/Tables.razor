@page "/ui/tables"
@using DashboardTheKingThePower.Components.ui
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Tabelas</PageTitle>

<h1 class="text-2xl font-bold mb-1">Tabelas</h1>
<p class="text-sm text-[var(--muted-foreground)] mb-6">Padrões usados nas telas de CRUD do projeto.</p>

<div class="space-y-8 max-w-4xl">
    <section>
        <h2 class="font-semibold mb-3">Simples</h2>
        <Card>
            <table class="w-full">
                <thead>
                    <tr class="border-b border-[var(--border)]">
                        <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Produto</th>
                        <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Preço</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _demo)
                    {
                        <tr class="border-b border-[var(--border)]">
                            <td class="p-4 text-sm">@p.Nome</td>
                            <td class="p-4 text-sm">@p.Preco</td>
                        </tr>
                    }
                </tbody>
            </table>
        </Card>
    </section>

    <section>
        <h2 class="font-semibold mb-3">Com status e ações</h2>
        <Card>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-[var(--border)]">
                            <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Produto</th>
                            <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Preço</th>
                            <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Status</th>
                            <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _demo)
                        {
                            <tr class="border-b border-[var(--border)] hover:bg-[var(--secondary)] transition-colors">
                                <td class="p-4 text-sm font-medium">@p.Nome</td>
                                <td class="p-4 text-sm">@p.Preco</td>
                                <td class="p-4"><Badge Variant="success">Ativo</Badge></td>
                                <td class="p-4">
                                    <button class="text-sm text-[var(--primary)] hover:underline mr-3">Editar</button>
                                    <button class="text-sm text-red-500 hover:underline">Excluir</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Card>
    </section>
</div>

@code {
    private record Demo(string Nome, string Preco);
    private List<Demo> _demo = new()
    {
        new("Tênis Corrida Pro", "R$ 299,90"),
        new("Camiseta Algodão", "R$ 79,90"),
        new("Mochila Urban", "R$ 189,90"),
    };
}
