@page "/ui/badges"
@using DashboardTheKingThePower.Components.ui
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Badges</PageTitle>

<h1 class="text-2xl font-bold mb-1">Badges</h1>
<p class="text-sm text-[var(--muted-foreground)] mb-6">Etiquetas para status, categorias e contadores.</p>

<div class="space-y-6 max-w-3xl">
    <section>
        <h2 class="font-semibold mb-3">Variantes do componente</h2>
        <div class="flex flex-wrap gap-2">
            <Badge>Padrão</Badge>
            <Badge Variant="success">Sucesso</Badge>
            <Badge Variant="warning">Aviso</Badge>
            <Badge Variant="error">Erro</Badge>
        </div>
    </section>
    <section>
        <h2 class="font-semibold mb-3">Status de pedido</h2>
        <div class="flex flex-wrap gap-2">
            <Badge Variant="warning">Pendente</Badge>
            <Badge Variant="success">Pago</Badge>
            <Badge>Pago na entrega</Badge>
            <Badge Variant="error">Cancelado</Badge>
        </div>
    </section>
    <section>
        <h2 class="font-semibold mb-3">Contadores</h2>
        <div class="flex flex-wrap items-center gap-2 text-sm">
            <span class="text-[var(--muted-foreground)]">Pendências</span>
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-500 text-white text-xs">5</span>
            <span class="text-[var(--muted-foreground)]">Novas mensagens</span>
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-[var(--primary)] text-white text-xs">12</span>
        </div>
    </section>
</div>
