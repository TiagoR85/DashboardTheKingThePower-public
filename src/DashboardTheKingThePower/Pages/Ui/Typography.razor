@page "/ui/typography"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Tipografia</PageTitle>

<h1 class="text-2xl font-bold mb-1">Tipografia</h1>
<p class="text-sm text-[var(--muted-foreground)] mb-6">Escala de textos usada no projeto.</p>

<div class="space-y-6 max-w-3xl">
    <section class="border-b border-[var(--border)] pb-4">
        <p class="text-xs text-[var(--muted-foreground)] mb-2">Títulos</p>
        <h1 class="text-4xl font-bold">Título 1 — text-4xl font-bold</h1>
        <h2 class="text-3xl font-bold mt-2">Título 2 — text-3xl font-bold</h2>
        <h3 class="text-2xl font-bold mt-2">Título 3 — text-2xl font-bold</h3>
        <h4 class="text-xl font-semibold mt-2">Título 4 — text-xl font-semibold</h4>
    </section>
    <section class="border-b border-[var(--border)] pb-4">
        <p class="text-xs text-[var(--muted-foreground)] mb-2">Corpo</p>
        <p class="text-base">Corpo de texto padrão (text-base) para parágrafos.</p>
        <p class="text-sm mt-2">Texto secundário (text-sm) para descrições.</p>
        <p class="text-xs mt-2 text-[var(--muted-foreground)]">Legenda (text-xs, muted) para apoio e metadados.</p>
    </section>
    <section>
        <p class="text-xs text-[var(--muted-foreground)] mb-2">Listas</p>
        <ul class="list-disc list-inside text-sm space-y-1">
            <li>Item de lista com marcador</li>
            <li>Segundo item da lista</li>
        </ul>
        <ol class="list-decimal list-inside text-sm space-y-1 mt-2">
            <li>Primeiro passo</li>
            <li>Segundo passo</li>
        </ol>
    </section>
</div>
