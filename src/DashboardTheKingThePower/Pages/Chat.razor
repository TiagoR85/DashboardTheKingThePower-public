@page "/chat"
@using DashboardTheKingThePower.Components.ui
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Chat</PageTitle>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6 h-[calc(100vh-140px)]">
    <Card>
        <div class="p-4 border-b border-[var(--border)]">
            <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="Buscar contatos..." />
        </div>
        <div class="divide-y divide-[var(--border)] overflow-y-auto">
            @foreach (var contact in contacts)
            {
                <div class="p-4 cursor-pointer hover:bg-[var(--muted)] @(selectedContact?.Id == contact.Id ? "bg-[var(--muted)]" : "")" @onclick="() => SelectContact(contact)">
                    <div class="flex items-center gap-3">
                        <div class="relative">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-sm" style="background-color: @contact.Color">
                                @contact.Name[0]
                            </div>
                            @if (contact.Online)
                            {
                                <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-[var(--background)]"></div>
                            }
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="font-medium text-sm">@contact.Name</p>
                            <p class="text-xs text-[var(--muted-foreground)] truncate">@contact.LastMessage</p>
                        </div>
                        <span class="text-xs text-[var(--muted-foreground)]">@contact.LastTime</span>
                    </div>
                </div>
            }
        </div>
    </Card>

    <div class="lg:col-span-3 flex flex-col">
        @if (selectedContact != null)
        {
            <Card class="flex-1 flex flex-col">
                <div class="p-4 border-b border-[var(--border)] flex items-center gap-3">
                    <div class="relative">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-sm" style="background-color: @selectedContact.Color">
                            @selectedContact.Name[0]
                        </div>
                        @if (selectedContact.Online)
                        {
                            <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-[var(--background)]"></div>
                        }
                    </div>
                    <div>
                        <p class="font-medium text-sm">@selectedContact.Name</p>
                        <p class="text-xs text-[var(--muted-foreground)]">@(selectedContact.Online ? "Online" : "Offline")</p>
                    </div>
                </div>

                <div class="flex-1 p-4 overflow-y-auto space-y-4">
                    @foreach (var message in messages.Where(m => m.ContactId == selectedContact.Id))
                    {
                        <div class="flex @(message.IsMe ? "justify-end" : "justify-start")">
                            <div class="max-w-[70%]">
                                <div class="px-4 py-2 rounded-lg @(message.IsMe ? "bg-[var(--primary)] text-white" : "bg-[var(--muted)]")">
                                    <p class="text-sm">@message.Text</p>
                                </div>
                                <p class="text-xs text-[var(--muted-foreground)] mt-1 @(message.IsMe ? "text-right" : "")">@message.Time</p>
                            </div>
                        </div>
                    }
                </div>

                <div class="p-4 border-t border-[var(--border)]">
                    <div class="flex items-center gap-2">
                        <button class="p-2 rounded-lg hover:bg-[var(--muted)]">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
                        </button>
                        <input class="flex-1 px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="Digite uma mensagem..." @bind="newMessage" @onkeydown="HandleKeyDown" />
                        <button class="px-4 py-2 bg-[var(--primary)] text-white rounded-lg hover:opacity-90" @onclick="SendMessage">Enviar</button>
                    </div>
                </div>
            </Card>
        }
        else
        {
            <Card>
                <div class="p-6 flex items-center justify-center h-full">
                    <p class="text-[var(--muted-foreground)]">Selecione um contato para começar a conversar</p>
                </div>
            </Card>
        }
    </div>
</div>
@code {
    private ChatContact? selectedContact;
    private string newMessage = "";

    private List<ChatContact> contacts = new()
    {
        new(1, "John Smith", "E aí, como você está?", "2 min", true, "#3b82f6"),
        new(2, "Sarah Johnson", "A reunião é às 10h", "15 min", true, "#10b981"),
        new(3, "Mike Wilson", "Obrigado pela atualização!", "1 h", false, "#f59e0b"),
        new(4, "Emily Davis", "Pode revisar isso?", "3 h", true, "#8b5cf6"),
        new(5, "Chris Brown", "Até amanhã!", "1 d", false, "#ec4899")
    };

    private List<ChatMessage> messages = new()
    {
        new(1, 1, "E aí! Como vai o projeto?", "10:30", false),
        new(1, 1, "Vai bem! Acabei de terminar o dashboard.", "10:32", true),
        new(1, 1, "Que legal! Mal posso esperar para ver.", "10:33", false),
        new(1, 1, "Te envio o link assim que estiver publicado.", "10:35", true),
        new(2, 2, "Oi! Só confirmando o horário da reunião.", "9:00", false),
        new(2, 2, "Sim, 10h fica ótimo para mim.", "9:05", true),
        new(2, 2, "Perfeito, até lá!", "9:06", false)
    };

    private void SelectContact(ChatContact contact) { selectedContact = contact; }

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage) || selectedContact == null) return;

        messages.Add(new ChatMessage(selectedContact.Id, selectedContact.Id, newMessage, DateTime.Now.ToString("h:mm tt"), true));
        newMessage = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SendMessage();
    }

    public record ChatContact(int Id, string Name, string LastMessage, string LastTime, bool Online, string Color);
    public record ChatMessage(int Id, int ContactId, string Text, string Time, bool IsMe);
}
