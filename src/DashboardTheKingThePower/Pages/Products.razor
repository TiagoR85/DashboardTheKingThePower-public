@page "/products"
@using DashboardTheKingThePower.Components.ui
@using DashboardTheKingThePower.Models
@using DashboardTheKingThePower.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ProductService ProductService

<PageTitle>Produtos</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Produtos</h1>
    <Button OnClick="ShowCreateModal">+ Novo Produto</Button>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Total de Produtos</p>
            <p class="text-2xl font-bold mt-1">@products.Count</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Em Estoque</p>
            <p class="text-2xl font-bold mt-1 text-green-500">@products.Count(p => p.Stock > 10)</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Estoque Baixo</p>
            <p class="text-2xl font-bold mt-1 text-yellow-500">@products.Count(p => p.Stock > 0 && p.Stock <= 10)</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Sem Estoque</p>
            <p class="text-2xl font-bold mt-1 text-red-500">@products.Count(p => p.Stock == 0)</p>
        </div>
    </Card>
</div>

<Card>
    <div class="p-4 border-b border-[var(--border)] flex flex-wrap items-center gap-4">
        <input class="flex-1 min-w-[200px] px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="Buscar produtos..." @bind="searchTerm" />
        <select class="px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="filterCategory">
            <option value="all">Todas as Categorias</option>
            <option value="electronics">Electronics</option>
            <option value="clothing">Clothing</option>
            <option value="home">Home</option>
            <option value="sports">Sports</option>
        </select>
        <select class="px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="filterStockStatus">
            <option value="all">Todos</option>
            <option value="in">Em Estoque</option>
            <option value="low">Estoque Baixo</option>
            <option value="out">Sem Estoque</option>
        </select>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-[var(--border)]">
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">ID do Produto</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Nome</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Categoria</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Preço</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Estoque</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Status</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in filteredProducts)
                {
                    @if (editingId == product.Id)
                    {
                        <tr class="border-b border-[var(--border)] bg-[var(--muted)]">
                            <td class="p-4 text-sm text-[var(--muted-foreground)]">@product.Id</td>
                            <td class="p-4">
                                <input class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editName" />
                            </td>
                            <td class="p-4">
                                <select class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editCategory">
                                    <option value="Electronics">Electronics</option>
                                    <option value="Clothing">Clothing</option>
                                    <option value="Home">Home</option>
                                    <option value="Sports">Sports</option>
                                </select>
                            </td>
                            <td class="p-4">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editPrice" />
                            </td>
                            <td class="p-4">
                                <input type="number" class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editStock" />
                            </td>
                            <td class="p-4">
                                <span class="text-xs px-2 py-1 rounded-full" style="background-color: @GetStockStatusColor(product.Id); color: white;">@GetStockStatus(product)</span>
                            </td>
                            <td class="p-4">
                                <button class="text-green-500 hover:text-green-700 text-sm mr-2" @onclick="SaveEdit">Salvar</button>
                                <button class="text-[var(--muted-foreground)] hover:text-[var(--foreground)] text-sm" @onclick="CancelEdit">Cancelar</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="border-b border-[var(--border)] hover:bg-[var(--muted)]">
                            <td class="p-4 text-sm text-[var(--muted-foreground)]">@product.Id</td>
                            <td class="p-4"><a href="products/@product.Id" class="font-medium text-[var(--primary)] hover:underline">@product.Name</a></td>
                            <td class="p-4">
                                <span class="text-xs px-2 py-1 rounded-full bg-[var(--muted)] text-[var(--foreground)]">@product.Category</span>
                            </td>
                            <td class="p-4 font-medium">$@product.Price.ToString("F2")</td>
                            <td class="p-4">
                                <span class="font-medium" style="color: @GetStockColor(product.Stock);">@product.Stock</span>
                            </td>
                            <td class="p-4">
                                <span class="text-xs px-2 py-1 rounded-full" style="background-color: @GetStockStatusColor(product.Id); color: white;">@GetStockStatus(product)</span>
                            </td>
                            <td class="p-4">
                                <button class="text-blue-500 hover:text-blue-700 text-sm mr-2" @onclick="() => StartEdit(product)">Editar</button>
                                <button class="text-red-500 hover:text-red-700 text-sm" @onclick="() => ConfirmDelete(product)">Excluir</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</Card>

@if (showDeleteModal)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-[var(--background)] border border-[var(--border)] rounded-lg p-6 w-full max-w-md">
            <h3 class="text-lg font-bold mb-2">Excluir Produto</h3>
            <p class="text-[var(--muted-foreground)] mb-6">Tem certeza de que deseja excluir <strong>@deleteTarget?.Name</strong>? Esta ação não pode ser desfeita.</p>
            <div class="flex justify-end gap-2">
                <Button OnClick="CancelDelete">Cancelar</Button>
                <button class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 text-sm" @onclick="DeleteProduct">Excluir</button>
            </div>
        </div>
    </div>
}

@if (showCreateModal)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-[var(--background)] border border-[var(--border)] rounded-lg p-6 w-full max-w-md">
            <h3 class="text-lg font-bold mb-4">Novo Produto</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1">Nome</label>
                    <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newName" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Categoria</label>
                    <select class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newCategory">
                        <option value="Electronics">Electronics</option>
                        <option value="Clothing">Clothing</option>
                        <option value="Home">Home</option>
                        <option value="Sports">Sports</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Preço</label>
                    <input type="number" step="0.01" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newPrice" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Estoque</label>
                    <input type="number" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newStock" />
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-6">
                <Button OnClick="CancelCreate">Cancelar</Button>
                <Button OnClick="CreateProduct">Criar</Button>
            </div>
        </div>
    </div>
}
@code {
    private string searchTerm = "";
    private string filterCategory = "all";
    private string filterStockStatus = "all";

    private List<Product> products = new();

    protected override async Task OnInitializedAsync() => products = await ProductService.GetAsync();

    private IEnumerable<Product> filteredProducts => products
        .Where(p =>
            (filterCategory == "all" || p.Category.ToLower() == filterCategory) &&
            (filterStockStatus == "all" ||
                (filterStockStatus == "in" && p.Stock > 10) ||
                (filterStockStatus == "low" && p.Stock > 0 && p.Stock <= 10) ||
                (filterStockStatus == "out" && p.Stock == 0)) &&
            (string.IsNullOrEmpty(searchTerm) ||
                p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Id.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private string? editingId;
    private string editName = "";
    private string editCategory = "";
    private decimal editPrice;
    private int editStock;

    private bool showDeleteModal;
    private Product? deleteTarget;

    private bool showCreateModal;
    private string newName = "";
    private string newCategory = "Electronics";
    private decimal newPrice;
    private int newStock;

    private void StartEdit(Product product)
    {
        editingId = product.Id;
        editName = product.Name;
        editCategory = product.Category;
        editPrice = product.Price;
        editStock = product.Stock;
    }

    private void CancelEdit()
    {
        editingId = null;
    }

    private async Task SaveEdit()
    {
        if (editingId is null) return;
        var index = products.FindIndex(p => p.Id == editingId);
        if (index < 0) return;
        products[index].Name = editName;
        products[index].Category = editCategory;
        products[index].Price = editPrice;
        products[index].Stock = editStock;
        editingId = null;
        await ProductService.SaveAsync(products);
    }

    private void ConfirmDelete(Product product)
    {
        deleteTarget = product;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        deleteTarget = null;
    }

    private async Task DeleteProduct()
    {
        if (deleteTarget is null) return;
        products.RemoveAll(p => p.Id == deleteTarget.Id);
        showDeleteModal = false;
        deleteTarget = null;
        await ProductService.SaveAsync(products);
    }

    private void ShowCreateModal()
    {
        newName = "";
        newCategory = "Electronics";
        newPrice = 0;
        newStock = 0;
        showCreateModal = true;
    }

    private void CancelCreate()
    {
        showCreateModal = false;
    }

    private async Task CreateProduct()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        var nextId = ProductService.NextId(products);
        products.Add(new Product { Id = nextId, Name = newName, Category = newCategory, Price = newPrice, Stock = newStock });
        showCreateModal = false;
        await ProductService.SaveAsync(products);
    }

    private string GetStockStatus(Product product) => GetStockStatusById(product.Id);

    private string GetStockStatusById(string id)
    {
        var product = products.FirstOrDefault(p => p.Id == id);
        if (product is null) return "Desconhecido";
        return product.Stock > 10 ? "Em Estoque" : product.Stock > 0 ? "Estoque Baixo" : "Sem Estoque";
    }

    private string GetStockStatusColor(string id)
    {
        var product = products.FirstOrDefault(p => p.Id == id);
        if (product is null) return "#6b7280";
        return product.Stock > 10 ? "#10b981" : product.Stock > 0 ? "#f59e0b" : "#ef4444";
    }

    private string GetStockColor(int stock)
    {
        return stock > 10 ? "#10b981" : stock > 0 ? "#f59e0b" : "#ef4444";
    }
}