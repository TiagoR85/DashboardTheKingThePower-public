@page "/invoices"
@using DashboardTheKingThePower.Components.ui
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Faturas</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Faturas</h1>
    <Button OnClick="ShowCreateModal">+ Nova Fatura</Button>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Total Faturado</p>
            <p class="text-2xl font-bold mt-1">$@TotalInvoiced.ToString("N0")</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Pago</p>
            <p class="text-2xl font-bold mt-1 text-green-500">$@PaidTotal.ToString("N0")</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Pendente</p>
            <p class="text-2xl font-bold mt-1 text-yellow-500">$@PendingTotal.ToString("N0")</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Vencido</p>
            <p class="text-2xl font-bold mt-1 text-red-500">$@OverdueTotal.ToString("N0")</p>
        </div>
    </Card>
</div>

<Card>
    <div class="p-4 border-b border-[var(--border)] flex items-center gap-4">
        <input class="flex-1 px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="Buscar faturas..." @bind="searchTerm" />
        <select class="px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="filterStatus">
            <option value="all">Todos os Status</option>
            <option value="paid">Pago</option>
            <option value="pending">Pendente</option>
            <option value="overdue">Vencido</option>
            <option value="draft">Rascunho</option>
        </select>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-[var(--border)]">
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Fatura</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Cliente</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Data</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Vencimento</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Valor</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Status</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in filteredInvoices)
                {
                    <tr class="border-b border-[var(--border)] hover:bg-[var(--muted)]">
                        <td class="p-4 font-medium">@invoice.Id</td>
                        <td class="p-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs" style="background-color: @invoice.Color">
                                    @invoice.Client.Split(' ').Select(n => n[0].ToString()).Aggregate("", (a, b) => a + b)
                                </div>
                                <span>@invoice.Client</span>
                            </div>
                        </td>
                        <td class="p-4 text-sm text-[var(--muted-foreground)]">@invoice.Date.ToString("yyyy-MM-dd")</td>
                        <td class="p-4 text-sm text-[var(--muted-foreground)]">@invoice.DueDate.ToString("yyyy-MM-dd")</td>
                        <td class="p-4 font-medium">$@invoice.Amount.ToString("N0")</td>
                        <td class="p-4">
                            @if (invoice.Status == "Paid")
                            {
                                <Badge Variant="success">Pago</Badge>
                            }
                            else if (invoice.Status == "Pending")
                            {
                                <Badge Variant="warning">Pendente</Badge>
                            }
                            else if (invoice.Status == "Overdue")
                            {
                                <Badge Variant="error">Vencido</Badge>
                            }
                            else
                            {
                                <Badge Variant="default">Rascunho</Badge>
                            }
                        </td>
                        <td class="p-4">
                            <button class="text-[var(--muted-foreground)] hover:text-[var(--foreground)] mr-2" @onclick="() => ShowViewModal(invoice)">Ver</button>
                            <button class="text-[var(--muted-foreground)] hover:text-[var(--foreground)] mr-2" @onclick="() => ShowEditModal(invoice)">Editar</button>
                            <button class="text-red-500 hover:text-red-700" @onclick="() => ShowDeleteModal(invoice)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</Card>

@* Create Modal *@
<Modal IsOpen="showCreateModal" OnClose="CloseCreateModal">
    <div class="p-6">
        <h2 class="text-lg font-bold mb-4">Criar Nova Fatura</h2>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium mb-1">Cliente</label>
                <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newInvoiceClient" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Valor</label>
                <input type="number" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newInvoiceAmount" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Data</label>
                <input type="date" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newInvoiceDate" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Vencimento</label>
                <input type="date" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newInvoiceDueDate" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Status</label>
                <select class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newInvoiceStatus">
                    <option value="Draft">Rascunho</option>
                    <option value="Pending">Pendente</option>
                    <option value="Paid">Pago</option>
                    <option value="Overdue">Vencido</option>
                </select>
            </div>
        </div>
        <div class="flex justify-end gap-2 mt-6">
            <Button Variant="secondary" OnClick="CloseCreateModal">Cancelar</Button>
            <Button OnClick="CreateInvoice">Criar</Button>
        </div>
    </div>
</Modal>

@* View Modal *@
<Modal IsOpen="showViewModal" OnClose="CloseViewModal">
    <div class="p-6">
        <h2 class="text-lg font-bold mb-4">Detalhes da Fatura</h2>
        @if (selectedInvoice != null)
        {
            <div class="space-y-3">
                <div class="flex justify-between">
                    <span class="text-sm text-[var(--muted-foreground)]">Fatura #</span>
                    <span class="font-medium">@selectedInvoice.Id</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-[var(--muted-foreground)]">Cliente</span>
                    <span class="font-medium">@selectedInvoice.Client</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-[var(--muted-foreground)]">Valor</span>
                    <span class="font-medium">$@selectedInvoice.Amount.ToString("N0")</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-[var(--muted-foreground)]">Data</span>
                    <span class="font-medium">@selectedInvoice.Date.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-[var(--muted-foreground)]">Vencimento</span>
                    <span class="font-medium">@selectedInvoice.DueDate.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-[var(--muted-foreground)]">Status</span>
                    @if (selectedInvoice.Status == "Paid")
                    {
                        <Badge Variant="success">Pago</Badge>
                    }
                    else if (selectedInvoice.Status == "Pending")
                    {
                        <Badge Variant="warning">Pendente</Badge>
                    }
                    else if (selectedInvoice.Status == "Overdue")
                    {
                        <Badge Variant="error">Vencido</Badge>
                    }
                    else
                    {
                        <Badge Variant="default">Rascunho</Badge>
                    }
                </div>
            </div>
        }
        <div class="flex justify-end mt-6">
            <Button Variant="secondary" OnClick="CloseViewModal">Fechar</Button>
        </div>
    </div>
</Modal>

@* Edit Modal *@
<Modal IsOpen="showEditModal" OnClose="CloseEditModal">
    <div class="p-6">
        <h2 class="text-lg font-bold mb-4">Editar Fatura</h2>
        @if (selectedInvoice != null)
        {
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1">Cliente</label>
                    <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="editInvoiceClient" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Valor</label>
                    <input type="number" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="editInvoiceAmount" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Data</label>
                    <input type="date" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="editInvoiceDate" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Vencimento</label>
                    <input type="date" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="editInvoiceDueDate" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Status</label>
                    <select class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="editInvoiceStatus">
                        <option value="Draft">Rascunho</option>
                        <option value="Pending">Pendente</option>
                        <option value="Paid">Pago</option>
                        <option value="Overdue">Vencido</option>
                    </select>
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-6">
                <Button Variant="secondary" OnClick="CloseEditModal">Cancelar</Button>
                <Button OnClick="SaveEdit">Salvar</Button>
            </div>
        }
    </div>
</Modal>

@* Delete Confirmation Modal *@
<Modal IsOpen="showDeleteModal" OnClose="CloseDeleteModal">
    <div class="p-6">
        <h2 class="text-lg font-bold mb-4">Excluir Fatura</h2>
        @if (selectedInvoice != null)
        {
            <p class="text-sm text-[var(--muted-foreground)] mb-6">
                Tem certeza que deseja excluir a fatura <strong>@selectedInvoice.Id</strong> de <strong>@selectedInvoice.Client</strong>? Esta ação não pode ser desfeita.
            </p>
        }
        <div class="flex justify-end gap-2">
            <Button Variant="secondary" OnClick="CloseDeleteModal">Cancelar</Button>
            <Button Variant="ghost" OnClick="ConfirmDelete">Excluir</Button>
        </div>
    </div>
</Modal>
@code {
    private string searchTerm = "";
    private string filterStatus = "all";

    private bool showCreateModal = false;
    private bool showViewModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;

    private Invoice? selectedInvoice;

    private string newInvoiceClient = "";
    private decimal newInvoiceAmount = 0;
    private DateTime newInvoiceDate = DateTime.Today;
    private DateTime newInvoiceDueDate = DateTime.Today.AddDays(14);
    private string newInvoiceStatus = "Draft";

    private string editInvoiceClient = "";
    private decimal editInvoiceAmount = 0;
    private DateTime editInvoiceDate = DateTime.Today;
    private DateTime editInvoiceDueDate = DateTime.Today.AddDays(14);
    private string editInvoiceStatus = "";

    private string GenerateNextId()
    {
        var maxNum = invoices
            .Select(i => int.TryParse(i.Id.Replace("INV-", ""), out var n) ? n : 0)
            .DefaultIfEmpty(0)
            .Max();
        return $"INV-{(maxNum + 1):D3}";
    }

    private string GetStatusColor(string status) => status switch
    {
        "Paid" => "#10b981",
        "Pending" => "#f59e0b",
        "Overdue" => "#ef4444",
        _ => "#6b7280"
    };

    private string GetAvatarColor(string client)
    {
        var colors = new[] { "#3b82f6", "#10b981", "#f59e0b", "#8b5cf6", "#ec4899", "#ef4444", "#14b8a6", "#f97316" };
        var hash = 0;
        foreach (var c in client) hash = (hash * 31 + c) % colors.Length;
        return colors[Math.Abs(hash)];
    }

    private decimal TotalInvoiced => invoices.Sum(i => i.Amount);
    private decimal PaidTotal => invoices.Where(i => i.Status == "Paid").Sum(i => i.Amount);
    private decimal PendingTotal => invoices.Where(i => i.Status == "Pending").Sum(i => i.Amount);
    private decimal OverdueTotal => invoices.Where(i => i.Status == "Overdue").Sum(i => i.Amount);

    private List<Invoice> invoices = new()
    {
        new("INV-001", "Acme Corp", new DateTime(2026, 8, 1), new DateTime(2026, 8, 15), 5000, "Paid", "#10b981", "#3b82f6"),
        new("INV-002", "TechStart", new DateTime(2026, 8, 3), new DateTime(2026, 8, 17), 2500, "Pending", "#f59e0b", "#10b981"),
        new("INV-003", "Global Inc", new DateTime(2026, 8, 5), new DateTime(2026, 8, 19), 8000, "Paid", "#10b981", "#f59e0b"),
        new("INV-004", "Creative Co", new DateTime(2026, 7, 20), new DateTime(2026, 8, 3), 3500, "Overdue", "#ef4444", "#8b5cf6"),
        new("INV-005", "Future Labs", new DateTime(2026, 8, 7), new DateTime(2026, 8, 21), 1200, "Pending", "#f59e0b", "#ec4899"),
        new("INV-006", "Acme Corp", new DateTime(2026, 7, 15), new DateTime(2026, 7, 29), 4200, "Paid", "#10b981", "#3b82f6"),
        new("INV-007", "TechStart", new DateTime(2026, 8, 10), new DateTime(2026, 8, 24), 6800, "Pending", "#f59e0b", "#10b981"),
        new("INV-008", "BlueSky Solutions", new DateTime(2026, 8, 2), new DateTime(2026, 8, 16), 3200, "Paid", "#10b981", "#14b8a6"),
        new("INV-009", "Zenith Partners", new DateTime(2026, 7, 25), new DateTime(2026, 8, 8), 5600, "Overdue", "#ef4444", "#f97316"),
        new("INV-010", "Orion Digital", new DateTime(2026, 8, 9), new DateTime(2026, 8, 23), 1800, "Draft", "#6b7280", "#3b82f6")
    };

    private IEnumerable<Invoice> filteredInvoices => invoices
        .Where(i => (filterStatus == "all" || i.Status.ToLower() == filterStatus) &&
                     (string.IsNullOrEmpty(searchTerm) || i.Client.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || i.Id.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private void ShowCreateModal()
    {
        newInvoiceClient = "";
        newInvoiceAmount = 0;
        newInvoiceDate = DateTime.Today;
        newInvoiceDueDate = DateTime.Today.AddDays(14);
        newInvoiceStatus = "Draft";
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
    }

    private void CreateInvoice()
    {
        if (string.IsNullOrWhiteSpace(newInvoiceClient) || newInvoiceAmount <= 0)
            return;

        var id = GenerateNextId();
        var status = newInvoiceStatus;
        var statusColor = GetStatusColor(status);
        var color = GetAvatarColor(newInvoiceClient);

        invoices.Add(new Invoice(
            id,
            newInvoiceClient.Trim(),
            newInvoiceDate,
            newInvoiceDueDate,
            newInvoiceAmount,
            status,
            statusColor,
            color
        ));

        showCreateModal = false;
    }

    private void ShowViewModal(Invoice invoice)
    {
        selectedInvoice = invoice;
        showViewModal = true;
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        selectedInvoice = null;
    }

    private void ShowEditModal(Invoice invoice)
    {
        selectedInvoice = invoice;
        editInvoiceClient = invoice.Client;
        editInvoiceAmount = invoice.Amount;
        editInvoiceDate = invoice.Date;
        editInvoiceDueDate = invoice.DueDate;
        editInvoiceStatus = invoice.Status;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        selectedInvoice = null;
    }

    private void SaveEdit()
    {
        if (selectedInvoice == null) return;
        if (string.IsNullOrWhiteSpace(editInvoiceClient) || editInvoiceAmount <= 0) return;

        var index = invoices.FindIndex(i => i.Id == selectedInvoice.Id);
        if (index >= 0)
        {
            var statusColor = GetStatusColor(editInvoiceStatus);
            var color = GetAvatarColor(editInvoiceClient);
            invoices[index] = new Invoice(
                selectedInvoice.Id,
                editInvoiceClient.Trim(),
                editInvoiceDate,
                editInvoiceDueDate,
                editInvoiceAmount,
                editInvoiceStatus,
                statusColor,
                color
            );
        }

        showEditModal = false;
        selectedInvoice = null;
    }

    private void ShowDeleteModal(Invoice invoice)
    {
        selectedInvoice = invoice;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        selectedInvoice = null;
    }

    private void ConfirmDelete()
    {
        if (selectedInvoice != null)
        {
            invoices.RemoveAll(i => i.Id == selectedInvoice.Id);
        }
        showDeleteModal = false;
        selectedInvoice = null;
    }

    public record Invoice(string Id, string Client, DateTime Date, DateTime DueDate, decimal Amount, string Status, string StatusColor, string Color);
}
