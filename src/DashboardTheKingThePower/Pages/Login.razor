@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@using DashboardTheKingThePower.Components.ui
@using DashboardTheKingThePower.Services
@using Microsoft.AspNetCore.Authorization
@inject AuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-[var(--background)] p-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <div class="w-12 h-12 rounded-xl bg-[var(--primary)] flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold">Bem-vindo de volta</h1>
            <p class="text-[var(--muted-foreground)] mt-1">Entre na sua conta</p>
        </div>

        <Card>
            <div class="p-6">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="mb-4 p-3 bg-red-500/10 border border-red-500/20 rounded-lg text-red-500 text-sm">
                        @_errorMessage
                    </div>
                }
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Usuário</label>
                        <input @bind="_email" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" placeholder="Digite seu e-mail" />
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="text-sm font-medium">Senha</label>
                            <a href="forgot-password" class="text-sm text-[var(--primary)] hover:underline">Esqueceu a senha?</a>
                        </div>
                        <input type="password" @bind="_password" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" placeholder="••••••••" />
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" @bind="_rememberMe" id="remember" class="rounded border-[var(--border)]" />
                        <label for="remember" class="text-sm">Lembrar de mim</label>
                    </div>
                    <button @onclick="HandleLogin" disabled="@_isLoading" class="w-full py-2 bg-[var(--primary)] text-white rounded-lg hover:opacity-90 disabled:opacity-50">
                        @if (_isLoading)
                        {
                            <span>Entrando...</span>
                        }
                        else
                        {
                            <span>Entrar</span>
                        }
                    </button>
                </div>
                <div class="mt-6 text-center text-sm">
                    <span class="text-[var(--muted-foreground)]">Não tem uma conta?</span>
                    <a href="register" class="text-[var(--primary)] hover:underline ml-1">Cadastre-se</a>
                </div>
            </div>
        </Card>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private bool _rememberMe;
    private bool _isLoading;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            await AuthStateProvider.LoginAsync(_email, _password);
            Navigation.NavigateTo("");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
