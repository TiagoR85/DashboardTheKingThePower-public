@page "/orders/{Id}"
@using DashboardTheKingThePower.Components.ui
@using DashboardTheKingThePower.Models
@using DashboardTheKingThePower.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject OrderService OrderService
@inject NavigationManager Navigation

<PageTitle>Detalhe do pedido</PageTitle>

@if (!_loaded)
{
    <div class="flex items-center justify-center py-16"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[var(--primary)]"></div></div>
}
else if (_order == null)
{
    <div class="text-center py-16">
        <p class="text-sm text-[var(--muted-foreground)]">Pedido não encontrado.</p>
        <div class="mt-4">
            <Button Variant="secondary" OnClick='() => Navigation.NavigateTo("orders")'>Voltar aos pedidos</Button>
        </div>
    </div>
}
else
{
    <nav class="text-sm text-[var(--muted-foreground)] mb-6">
        <a href="" class="hover:text-[var(--foreground)]">Início</a> <span class="mx-1">/</span>
        <a href="orders" class="hover:text-[var(--foreground)]">Pedidos</a> <span class="mx-1">/</span>
        <span class="text-[var(--foreground)]">@_order.Id</span>
    </nav>

    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold">@_order.Id</h1>
        <Badge Variant="@StatusVariant(_order.Status)">@_order.Status</Badge>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2">
            <Card>
                <ChildContent>
                    <h2 class="font-semibold mb-4">Itens</h2>
                    <div class="divide-y divide-[var(--border)]">
                        @foreach (var item in _order.Items)
                        {
                            <div class="flex items-center justify-between py-3 text-sm">
                                <div>
                                    <p class="font-medium">@item.Name</p>
                                    <p class="text-xs text-[var(--muted-foreground)]">Qtd @item.Qty · R$ @item.Price.ToString("N2") un.</p>
                                </div>
                                <span class="font-medium">R$ @((item.Price * item.Qty).ToString("N2"))</span>
                            </div>
                        }
                        @if (_order.Items.Count == 0)
                        {
                            <p class="text-sm text-[var(--muted-foreground)] py-3">Sem itens detalhados para este pedido.</p>
                        }
                    </div>
                </ChildContent>
            </Card>

            <Card Class="mt-6">
                <ChildContent>
                    <h2 class="font-semibold mb-4">Andamento</h2>
                    <ol class="space-y-4">
                        @foreach (var step in _timeline)
                        {
                            <li class="flex items-center gap-3 text-sm">
                                <span class="w-3 h-3 rounded-full @(step.Done ? "bg-[var(--primary)]" : "bg-[var(--border)]")"></span>
                                <span class="@(step.Done ? "font-medium" : "text-[var(--muted-foreground)]")">@step.Label</span>
                                @if (step.Current) { <Badge Variant="warning">Atual</Badge> }
                            </li>
                        }
                    </ol>
                </ChildContent>
            </Card>
        </div>

        <div>
            <Card>
                <ChildContent>
                    <h2 class="font-semibold mb-4">Resumo</h2>
                    <dl class="space-y-2 text-sm">
                        <div class="flex justify-between"><dt class="text-[var(--muted-foreground)]">Cliente</dt><dd>@_order.Customer</dd></div>
                        <div class="flex justify-between"><dt class="text-[var(--muted-foreground)]">Data</dt><dd>@_order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>
                        <div class="flex justify-between"><dt class="text-[var(--muted-foreground)]">Subtotal</dt><dd>R$ @_order.Subtotal.ToString("N2")</dd></div>
                        <div class="flex justify-between"><dt class="text-[var(--muted-foreground)]">Frete</dt><dd>@(_order.Frete == 0 ? "Grátis" : $"R$ {_order.Frete:N2}")</dd></div>
                        <div class="flex justify-between font-bold text-base border-t border-[var(--border)] pt-2"><dt>Total</dt><dd>R$ @_order.Total.ToString("N2")</dd></div>
                    </dl>
                </ChildContent>
            </Card>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    private PlacedOrder? _order;
    private bool _loaded;
    private List<(string Label, bool Done, bool Current)> _timeline = new();

    private static readonly string[] Steps = { "Pendente", "Pago", "Enviado", "Entregue" };

    protected override async Task OnInitializedAsync()
    {
        var orders = await OrderService.GetAsync();
        _order = orders.FirstOrDefault(o => o.Id == Id);
        _loaded = true;
        if (_order == null) return;

        // Status vêm mistos no storage: seed em EN (Delivered/Shipped/Processing/Pending/Cancelled)
        // e checkout em PT-BR (Pendente). Índice calculado em ambos os idiomas.
        var idx = StatusIndex(_order.Status);
        // Cancelado (idx -1): nenhum passo concluído nem "Atual" — pedido sem progresso.
        _timeline = Steps
            .Select((s, i) => (Label: s, Done: idx >= 0 && i <= idx, Current: idx >= 0 && i == idx))
            .ToList();
    }

    // Pending/Pendente→0, Processing/Pago→1, Shipped/Enviado→2, Delivered/Entregue→3
    private static int StatusIndex(string status) => status switch
    {
        "Delivered" or "Entregue" => 3,
        "Shipped" or "Enviado" => 2,
        "Processing" or "Pago" => 1,
        "Cancelled" or "Cancelado" => -1, // sem etapa concluída/Atual
        _ => 0 // Pending/Pendente/qualquer desconhecido → base em Pendente
    };

    // Variantes espelhadas de Pages/Orders.razor (StatusBadgeVariant):
    // Delivered→success, Shipped→warning, Cancelled→error, Pending/Processing→default
    private static string StatusVariant(string status) => status switch
    {
        "Delivered" or "Entregue" or "Pago" => "success",
        "Shipped" or "Enviado" => "warning",
        "Cancelled" or "Cancelado" => "error",
        _ => "default" // Pending/Processing/Pendente
    };
}
