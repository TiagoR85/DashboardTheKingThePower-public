@page "/clientes"
@using DashboardTheKingThePower.Components.ui
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Clientes</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Clientes</h1>
    <Button OnClick="ShowCreateModal">+ Novo Cliente</Button>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Total de Clientes</p>
            <p class="text-2xl font-bold mt-1">@clients.Count</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Ativos</p>
            <p class="text-2xl font-bold mt-1 text-green-500">@clients.Count(c => c.Status == "Active")</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Inativos</p>
            <p class="text-2xl font-bold mt-1 text-gray-500">@clients.Count(c => c.Status == "Inactive")</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Novos este Mês</p>
            <p class="text-2xl font-bold mt-1 text-blue-500">@clients.Count(c => c.JoinedMonth == "Aug")</p>
        </div>
    </Card>
</div>

<Card>
    <div class="p-4 border-b border-[var(--border)] flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <input class="flex-1 w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="Buscar clientes..." @bind="searchTerm" />
        <select class="px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm w-full sm:w-auto" @bind="filterStatus">
            <option value="all">Todos os Status</option>
            <option value="active">Ativo</option>
            <option value="inactive">Inativo</option>
        </select>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-[var(--border)]">
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">ID</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Nome</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">E-mail</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Telefone</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Empresa</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Status</th>
                    <th class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in filteredClients)
                {
                    <tr class="border-b border-[var(--border)] hover:bg-[var(--muted)]">
                        <td class="p-4 font-medium text-sm">@client.Id</td>
                        <td class="p-4">
                            @if (editingClientId == client.Id)
                            {
                                <input class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editName" />
                            }
                            else
                            {
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-medium shrink-0" style="background-color: @client.Color">
                                        @client.Name.Split(' ').Where(n => n.Length > 0).Select(n => n[0].ToString()).Aggregate("", (a, b) => a + b).Substring(0, Math.Min(2, client.Name.Split(' ').Where(n => n.Length > 0).Select(n => n[0].ToString()).Aggregate("", (a, b) => a + b).Length))
                                    </div>
                                    <span class="font-medium">@client.Name</span>
                                </div>
                            }
                        </td>
                        <td class="p-4 text-sm text-[var(--muted-foreground)]">
                            @if (editingClientId == client.Id)
                            {
                                <input class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editEmail" />
                            }
                            else
                            {
                                @client.Email
                            }
                        </td>
                        <td class="p-4 text-sm text-[var(--muted-foreground)]">
                            @if (editingClientId == client.Id)
                            {
                                <input class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editPhone" />
                            }
                            else
                            {
                                @client.Phone
                            }
                        </td>
                        <td class="p-4 text-sm text-[var(--muted-foreground)]">
                            @if (editingClientId == client.Id)
                            {
                                <input class="w-full px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editCompany" />
                            }
                            else
                            {
                                @client.Company
                            }
                        </td>
                        <td class="p-4">
                            @if (editingClientId == client.Id)
                            {
                                <select class="px-2 py-1 border border-[var(--border)] rounded bg-[var(--background)] text-sm" @bind="editStatus">
                                    <option value="Active">Ativo</option>
                                    <option value="Inactive">Inativo</option>
                                </select>
                            }
                            else
                            {
                                @if (client.Status == "Active")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">Ativo</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300">Inativo</span>
                                }
                            }
                        </td>
                        <td class="p-4">
                            @if (editingClientId == client.Id)
                            {
                                <button class="text-green-500 hover:text-green-700 mr-2 text-sm font-medium" @onclick="SaveEdit">Salvar</button>
                                <button class="text-gray-500 hover:text-gray-700 text-sm font-medium" @onclick="CancelEdit">Cancelar</button>
                            }
                            else
                            {
                                <button class="text-[var(--muted-foreground)] hover:text-[var(--foreground)] mr-2 text-sm font-medium" @onclick="() => StartEdit(client)">Editar</button>
                                <button class="text-red-500 hover:text-red-700 text-sm font-medium" @onclick="() => ConfirmDelete(client)">Excluir</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!filteredClients.Any())
        {
            <div class="p-8 text-center text-[var(--muted-foreground)] text-sm">Nenhum cliente encontrado.</div>
        }
    </div>
</Card>

<Modal IsOpen="showDeleteModal" OnClose="() => showDeleteModal = false">
    <div class="p-6">
        <h3 class="text-lg font-semibold mb-2">Confirmar Exclusão</h3>
        <p class="text-sm text-[var(--muted-foreground)] mb-6">
            Tem certeza que deseja excluir o cliente <strong>@clientToDelete?.Name</strong>? Esta ação não pode ser desfeita.
        </p>
        <div class="flex justify-end gap-3">
            <Button Variant="secondary" OnClick="() => showDeleteModal = false">Cancelar</Button>
            <button class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-red-600 text-white hover:bg-red-700" @onclick="DeleteClient">Excluir</button>
        </div>
    </div>
</Modal>

<Modal IsOpen="showCreateModal" OnClose="() => showCreateModal = false">
    <div class="p-6">
        <h3 class="text-lg font-semibold mb-4">Novo Cliente</h3>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium mb-1">Nome</label>
                <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newName" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">E-mail</label>
                <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newEmail" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Telefone</label>
                <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" placeholder="(11) 99999-9999" @bind="newPhone" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Empresa</label>
                <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newCompany" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Status</label>
                <select class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="newStatus">
                    <option value="Active">Ativo</option>
                    <option value="Inactive">Inativo</option>
                </select>
            </div>
        </div>
        <div class="flex justify-end gap-3 mt-6">
            <Button Variant="secondary" OnClick="() => showCreateModal = false">Cancelar</Button>
            <Button OnClick="CreateClient">Criar Cliente</Button>
        </div>
    </div>
</Modal>
@code {
    private string searchTerm = "";
    private string filterStatus = "all";

    private string? editingClientId;
    private string editName = "";
    private string editEmail = "";
    private string editPhone = "";
    private string editCompany = "";
    private string editStatus = "";

    private bool showDeleteModal = false;
    private Client? clientToDelete;

    private bool showCreateModal = false;
    private string newName = "";
    private string newEmail = "";
    private string newPhone = "";
    private string newCompany = "";
    private string newStatus = "Active";

    private string[] avatarColors = new[]
    {
        "#3b82f6", "#10b981", "#8b5cf6", "#ef4444", "#f59e0b",
        "#ec4899", "#06b6d4", "#84cc16", "#f97316", "#6366f1",
        "#14b8a6", "#e11d48"
    };

    private List<Client> clients = new()
    {
        new("CLI-001", "João Silva", "joao.silva@empresa.com.br", "(11) 99876-5432", "TechBR Soluções", "Active", "Aug", "#3b82f6"),
        new("CLI-002", "Maria Santos", "maria.santos@techcorp.com.br", "(21) 98765-4321", "TechCorp Brasil", "Active", "Aug", "#ec4899"),
        new("CLI-003", "Pedro Oliveira", "pedro.oliveira@innovate.com.br", "(31) 97654-3210", "Innovate Digital", "Active", "Jul", "#10b981"),
        new("CLI-004", "Ana Ferreira", "ana.ferreira@startupbr.com.br", "(41) 96543-2109", "StartupBR", "Inactive", "Jul", "#f59e0b"),
        new("CLI-005", "Carlos Souza", "carlos.souza@globaltech.com.br", "(51) 95432-1098", "GlobalTech SA", "Active", "Jun", "#8b5cf6"),
        new("CLI-006", "Juliana Lima", "juliana.lima@digitalhouse.com.br", "(11) 94321-0987", "Digital House", "Active", "Jun", "#ef4444"),
        new("CLI-007", "Roberto Almeida", "roberto.almeida@websolutions.com.br", "(21) 93210-9876", "Web Solutions Ltda", "Active", "May", "#06b6d4"),
        new("CLI-008", "Fernanda Costa", "fernanda.costa@dataflow.com.br", "(31) 92109-8765", "DataFlow Sistemas", "Inactive", "May", "#84cc16"),
        new("CLI-009", "Lucas Pereira", "lucas.pereira@cloudnine.com.br", "(41) 91098-7654", "CloudNine Software", "Active", "Apr", "#f97316"),
        new("CLI-010", "Beatriz Rodrigues", "beatriz.rodrigues@nexgen.com.br", "(51) 90987-6543", "NexGen Tecnologia", "Active", "Apr", "#6366f1"),
        new("CLI-011", "Ricardo Martins", "ricardo.martins@apexdata.com.br", "(11) 90876-5432", "ApexData Consultoria", "Inactive", "Mar", "#14b8a6"),
        new("CLI-012", "Camila Ferreira", "camila.ferreira@primecode.com.br", "(21) 90765-4321", "PrimeCode Labs", "Active", "Mar", "#e11d48")
    };

    private IEnumerable<Client> filteredClients => clients
        .Where(c => (filterStatus == "all" || c.Status.ToLower() == filterStatus) &&
                     (string.IsNullOrEmpty(searchTerm) ||
                      c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                      c.Id.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                      c.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                      c.Company.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private void ShowCreateModal()
    {
        newName = "";
        newEmail = "";
        newPhone = "";
        newCompany = "";
        newStatus = "Active";
        showCreateModal = true;
    }

    private void CreateClient()
    {
        if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newEmail))
            return;

        var nextId = clients.Count + 1;
        var color = avatarColors[nextId % avatarColors.Length];
        var now = DateTime.Now;
        var month = now.ToString("MMM");
        clients.Add(new Client(
            $"CLI-{nextId:D3}",
            newName,
            newEmail,
            newPhone,
            newCompany,
            newStatus,
            month,
            color
        ));
        showCreateModal = false;
    }

    private void StartEdit(Client client)
    {
        editingClientId = client.Id;
        editName = client.Name;
        editEmail = client.Email;
        editPhone = client.Phone;
        editCompany = client.Company;
        editStatus = client.Status;
    }

    private void SaveEdit()
    {
        if (editingClientId == null) return;

        var index = clients.FindIndex(c => c.Id == editingClientId);
        if (index >= 0)
        {
            clients[index] = clients[index] with
            {
                Name = editName,
                Email = editEmail,
                Phone = editPhone,
                Company = editCompany,
                Status = editStatus
            };
        }
        editingClientId = null;
    }

    private void CancelEdit()
    {
        editingClientId = null;
    }

    private void ConfirmDelete(Client client)
    {
        clientToDelete = client;
        showDeleteModal = true;
    }

    private void DeleteClient()
    {
        if (clientToDelete != null)
        {
            clients.Remove(clientToDelete);
            clientToDelete = null;
            showDeleteModal = false;
        }
    }

    public record Client(string Id, string Name, string Email, string Phone, string Company, string Status, string JoinedMonth, string Color);
}
