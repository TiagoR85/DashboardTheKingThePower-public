@page "/contacts"
@using DashboardTheKingThePower.Components.ui
@using DashboardTheKingThePower.Models
@using DashboardTheKingThePower.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ContactService ContactService
@inject ToastService Toast

<PageTitle>Contatos</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Contatos</h1>
    <Button OnClick="ShowAddModal">+ Novo Contato</Button>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
    @* Anti-flash: KPIs só mostram valor após o load (antes: piscava "0"). *@
    <Card><p class="text-sm text-[var(--muted-foreground)]">Total</p><p class="text-2xl font-bold mt-1">@(_loaded ? contacts.Count.ToString() : "—")</p></Card>
    <Card><p class="text-sm text-[var(--muted-foreground)]">Ativos</p><p class="text-2xl font-bold mt-1 text-green-500">@(_loaded ? contacts.Count(c => c.Status == "Ativo").ToString() : "—")</p></Card>
    <Card><p class="text-sm text-[var(--muted-foreground)]">Leads</p><p class="text-2xl font-bold mt-1 text-yellow-500">@(_loaded ? contacts.Count(c => c.Status == "Lead").ToString() : "—")</p></Card>
</div>

<div class="flex flex-col sm:flex-row gap-3 mb-6">
    <input class="flex-1 min-w-[200px] px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm"
           placeholder="Buscar por nome, email ou empresa..." @bind="searchTerm" @bind:event="oninput" />
    <select class="px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)] text-sm" @bind="statusFilter">
        <option value="">Todos os status</option>
        <option value="Ativo">Ativo</option>
        <option value="Lead">Lead</option>
        <option value="Inativo">Inativo</option>
    </select>
</div>

<Card>
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-[var(--border)]">
                    <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Nome</th>
                    <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Email</th>
                    <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Telefone</th>
                    <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Empresa</th>
                    <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Status</th>
                    <th scope="col" class="text-left p-4 text-sm font-medium text-[var(--muted-foreground)]">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in filtered)
                {
                    <tr class="border-b border-[var(--border)] hover:bg-[var(--secondary)] transition-colors">
                        <td class="p-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-[var(--primary)] text-white flex items-center justify-center text-xs">@Iniciais(c.Name)</div>
                                <span class="font-medium text-sm">@c.Name</span>
                            </div>
                        </td>
                        <td class="p-4 text-sm text-[var(--muted-foreground)]">@c.Email</td>
                        <td class="p-4 text-sm text-[var(--muted-foreground)]">@c.Phone</td>
                        <td class="p-4 text-sm">@c.Company</td>
                        <td class="p-4"><Badge Variant="@StatusVariant(c.Status)">@c.Status</Badge></td>
                        <td class="p-4">
                            <button class="text-sm text-[var(--primary)] hover:underline mr-3" @onclick="() => ShowEditModal(c)">Editar</button>
                            <button class="text-sm text-red-500 hover:underline" @onclick="() => ShowDeleteModal(c)">Excluir</button>
                        </td>
                    </tr>
                }
                @if (!_loaded)
                {
                    <tr><td colspan="6"><div class="flex items-center justify-center py-8"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[var(--primary)]"></div></div></td></tr>
                }
                else if (filtered.Count == 0)
                {
                    <tr><td colspan="6" class="p-8 text-center text-sm text-[var(--muted-foreground)]">Nenhum contato encontrado.</td></tr>
                }
            </tbody>
        </table>
    </div>
</Card>

@if (showModal)
{
    <Modal IsOpen="true" OnClose="CloseModal">
        <div class="p-6">
            <h2 class="text-lg font-semibold mb-4">@(editing == null ? "Novo Contato" : "Editar Contato")</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1" for="contact-nome">Nome</label>
                    <input id="contact-nome" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" @bind="formName" placeholder="Nome completo" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1" for="contact-email">Email</label>
                    <input id="contact-email" type="email" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" @bind="formEmail" placeholder="email@exemplo.com" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium mb-1" for="contact-telefone">Telefone</label>
                        <input id="contact-telefone" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" @bind="formPhone" placeholder="(00) 00000-0000" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1" for="contact-status">Status</label>
                        <select id="contact-status" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" @bind="formStatus">
                            <option value="Ativo">Ativo</option>
                            <option value="Lead">Lead</option>
                            <option value="Inativo">Inativo</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1" for="contact-empresa">Empresa</label>
                    <input id="contact-empresa" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" @bind="formCompany" placeholder="Nome da empresa" />
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-6">
                <button class="px-4 py-2 text-sm rounded-lg border border-[var(--border)] hover:bg-[var(--secondary)]" @onclick="CloseModal">Cancelar</button>
                <button class="px-4 py-2 text-sm rounded-lg bg-[var(--primary)] text-white hover:opacity-90" @onclick="SaveContact">Salvar</button>
            </div>
        </div>
    </Modal>
}

@if (showDelete)
{
    <Modal IsOpen="true" OnClose="CloseModal">
        <div class="p-6">
            <h2 class="text-lg font-semibold mb-2">Excluir contato</h2>
            <p class="text-sm text-[var(--muted-foreground)] mb-6">Confirma a exclusão de <strong>@editing?.Name</strong>? Essa ação não pode ser desfeita.</p>
            <div class="flex justify-end gap-2">
                <button class="px-4 py-2 text-sm rounded-lg border border-[var(--border)] hover:bg-[var(--secondary)]" @onclick="CloseModal">Cancelar</button>
                <button class="px-4 py-2 text-sm rounded-lg bg-red-500 text-white hover:bg-red-600" @onclick="DeleteContact">Excluir</button>
            </div>
        </div>
    </Modal>
}

@code {
    private List<Contact> contacts = new();
    private bool _loaded;
    private string searchTerm = "";
    private string statusFilter = "";

    private bool showModal = false;
    private bool showDelete = false;
    private Contact? editing = null;
    private string formName = "", formEmail = "", formPhone = "", formCompany = "", formStatus = "Ativo";

    private List<Contact> filtered => ContactService.Filter(contacts, searchTerm, statusFilter);

    protected override async Task OnInitializedAsync()
    {
        contacts = await ContactService.GetAsync();
        _loaded = true;
    }

    private static string Iniciais(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = string.Concat(parts.Select(p => char.ToUpperInvariant(p[0])));
        return initials.Length > 2 ? initials[..2] : initials;
    }

    private static string StatusVariant(string status) => status switch
    {
        "Ativo" => "success",
        "Lead" => "warning",
        _ => "default"
    };

    private void ShowAddModal()
    {
        editing = null;
        formName = formEmail = formPhone = formCompany = "";
        formStatus = "Ativo";
        showModal = true;
    }

    private void ShowEditModal(Contact c)
    {
        editing = c;
        formName = c.Name; formEmail = c.Email; formPhone = c.Phone;
        formCompany = c.Company; formStatus = c.Status;
        showModal = true;
    }

    private void ShowDeleteModal(Contact c) { editing = c; showDelete = true; }

    private void CloseModal() { showModal = false; showDelete = false; editing = null; }

    private async Task SaveContact()
    {
        if (string.IsNullOrWhiteSpace(formName) || string.IsNullOrWhiteSpace(formEmail))
        {
            Toast.ShowError("Nome e email são obrigatórios.");
            return;
        }
        if (editing == null)
        {
            var id = ContactService.NextId(contacts);
            contacts.Add(new Contact { Id = id, Name = formName.Trim(), Email = formEmail.Trim(), Phone = formPhone, Company = formCompany, Status = formStatus });
            Toast.ShowSuccess("Contato adicionado.");
        }
        else
        {
            editing.Name = formName.Trim(); editing.Email = formEmail.Trim();
            editing.Phone = formPhone; editing.Company = formCompany; editing.Status = formStatus;
            Toast.ShowSuccess("Contato atualizado.");
        }
        await ContactService.SaveAsync(contacts);
        CloseModal();
    }

    private async Task DeleteContact()
    {
        if (editing != null)
        {
            contacts.Remove(editing);
            await ContactService.SaveAsync(contacts);
            Toast.ShowSuccess("Contato excluído.");
        }
        CloseModal();
    }
}
