@page "/help"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Ajuda e Suporte</PageTitle>

<div class="max-w-5xl mx-auto space-y-12">

    <!-- Hero Section -->
    <div class="text-center py-8">
        <h1 class="text-3xl font-bold mb-2">Como podemos ajudar você?</h1>
        <p class="text-[var(--muted-foreground)] mb-6">Pesquise na nossa base de conhecimento ou navegue pelas categorias abaixo</p>
        <div class="max-w-xl mx-auto relative">
            <input @bind="_searchQuery" @bind:event="oninput" type="text"
                   placeholder="Buscar respostas..."
                   class="w-full h-12 pl-12 pr-4 rounded-xl border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] placeholder:text-[var(--muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]" />
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[var(--muted-foreground)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>
    </div>

    <!-- Quick Links Grid -->
    <div>
        <h2 class="text-xl font-bold mb-4">Links rápidos</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var link in _quickLinks)
            {
                <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-6 hover:border-[var(--primary)] transition-colors cursor-pointer group">
                    <div class="w-10 h-10 rounded-lg bg-[var(--primary)]/10 flex items-center justify-center mb-3">
                        @((MarkupString)link.Icon)
                    </div>
                    <h3 class="font-semibold mb-1 group-hover:text-[var(--primary)] transition-colors">@link.Title</h3>
                    <p class="text-sm text-[var(--muted-foreground)] mb-3">@link.Description</p>
                    <a href="#" class="text-sm font-medium text-[var(--primary)] hover:underline">Saiba mais &rarr;</a>
                </div>
            }
        </div>
    </div>

    <!-- FAQ Section -->
    <div>
        <h2 class="text-xl font-bold mb-4">Perguntas frequentes</h2>
        <div class="space-y-3">
            @foreach (var faq in _faqs)
            {
                <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] overflow-hidden">
                    <button @onclick="() => ToggleFaq(faq)" class="w-full flex items-center justify-between px-6 py-4 text-left">
                        <span class="font-medium pr-4">@faq.Question</span>
                        <svg class="w-5 h-5 text-[var(--muted-foreground)] shrink-0 transition-transform @(faq.IsOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    @if (faq.IsOpen)
                    {
                        <div class="px-6 pb-4 text-sm text-[var(--muted-foreground)] leading-relaxed">
                            @faq.Answer
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Popular Articles -->
    <div>
        <h2 class="text-xl font-bold mb-4">Artigos populares</h2>
        <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] divide-y divide-[var(--border)]">
            @foreach (var article in _articles)
            {
                <a href="#" class="flex items-center justify-between px-6 py-4 hover:bg-[var(--muted)]/50 transition-colors">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-[var(--primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span class="font-medium text-sm">@article.Title</span>
                    </div>
                    <span class="text-xs text-[var(--muted-foreground)] shrink-0">@article.Views visualizações</span>
                </a>
            }
        </div>
    </div>

    <!-- Contact Section -->
    <div>
        <h2 class="text-xl font-bold mb-4">Falar com o Suporte</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-6 text-center">
                <div class="w-12 h-12 rounded-full bg-green-500/10 flex items-center justify-center mx-auto mb-3">
                    <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                </div>
                <h3 class="font-semibold mb-1">Chat ao vivo</h3>
                <p class="text-sm text-[var(--muted-foreground)] mb-3">Converse com nossa equipe de suporte</p>
                <span class="text-xs text-green-500 font-medium">Online agora</span>
            </div>
            <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-6 text-center">
                <div class="w-12 h-12 rounded-full bg-[var(--primary)]/10 flex items-center justify-center mx-auto mb-3">
                    <svg class="w-6 h-6 text-[var(--primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
                <h3 class="font-semibold mb-1">Suporte por e-mail</h3>
                <p class="text-sm text-[var(--muted-foreground)] mb-3">support@thekingpower.com</p>
                <span class="text-xs text-[var(--muted-foreground)]">Resposta em até 24 horas</span>
            </div>
            <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-6 text-center">
                <div class="w-12 h-12 rounded-full bg-orange-500/10 flex items-center justify-center mx-auto mb-3">
                    <svg class="w-6 h-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                </div>
                <h3 class="font-semibold mb-1">Suporte por telefone</h3>
                <p class="text-sm text-[var(--muted-foreground)] mb-3">+1 (555) 123-4567</p>
                <span class="text-xs text-[var(--muted-foreground)]">Seg a sex, 9h às 18h (EST)</span>
            </div>
        </div>

        <!-- Support Ticket Form -->
        <div class="rounded-xl border border-[var(--border)] bg-[var(--card)]">
            <div class="px-6 py-4 border-b border-[var(--border)]">
                <h3 class="font-semibold">Abrir um chamado de suporte</h3>
                <p class="text-sm text-[var(--muted-foreground)]">Entraremos em contato o mais breve possível</p>
            </div>
            <div class="p-6 space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Assunto</label>
                        <input @bind="_ticketSubject" type="text" placeholder="Descrição breve do seu problema"
                               class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] placeholder:text-[var(--muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]" />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-1">Categoria</label>
                            <select @bind="_ticketCategory"
                                    class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]">
                                <option value="">Selecione...</option>
                                <option value="general">Dúvida geral</option>
                                <option value="bug">Relatório de bug</option>
                                <option value="feature">Solicitação de funcionalidade</option>
                                <option value="billing">Problema de cobrança</option>
                                <option value="account">Acesso à conta</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Prioridade</label>
                            <select @bind="_ticketPriority"
                                    class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]">
                                <option value="">Selecione...</option>
                                <option value="low">Baixa</option>
                                <option value="medium">Média</option>
                                <option value="high">Alta</option>
                                <option value="urgent">Urgente</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Descrição</label>
                    <textarea @bind="_ticketDescription" rows="4" placeholder="Forneça o máximo de detalhes possível..."
                              class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] placeholder:text-[var(--muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]"></textarea>
                </div>
                <div class="flex items-center justify-between">
                    <label class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[var(--border)] bg-[var(--muted)] text-sm font-medium cursor-pointer hover:bg-[var(--border)] transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                        </svg>
                        Anexar arquivo
                        <input type="file" class="hidden" @ref="_fileInput" />
                    </label>
                    <button @onclick="SubmitTicket" class="px-6 py-2 rounded-lg bg-[var(--primary)] text-[var(--primary-foreground)] text-sm font-medium hover:opacity-90 transition-opacity">
                        Enviar chamado
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_ticketMessage))
                {
                    <div class="p-3 rounded-lg text-sm @(_ticketSuccess ? "bg-green-500/10 border border-green-500/20 text-green-500" : "bg-red-500/10 border border-red-500/20 text-red-500")">
                        @_ticketMessage
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Footer CTA -->
    <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-8 text-center">
        <h2 class="text-xl font-bold mb-2">Ainda precisa de ajuda?</h2>
        <p class="text-[var(--muted-foreground)] mb-6">Nossa equipe de suporte está pronta para ajudar você com qualquer dúvida ou problema.</p>
        <div class="flex items-center justify-center gap-3">
            <button class="px-6 py-2 rounded-lg bg-[var(--primary)] text-[var(--primary-foreground)] text-sm font-medium hover:opacity-90 transition-opacity">
                Falar com o Suporte
            </button>
            <button class="px-6 py-2 rounded-lg border border-[var(--border)] text-sm font-medium hover:bg-[var(--muted)] transition-colors">
                Entrar na comunidade
            </button>
        </div>
    </div>
</div>
@code {
    private string _searchQuery = "";
    private string _ticketSubject = "";
    private string _ticketCategory = "";
    private string _ticketPriority = "";
    private string _ticketDescription = "";
    private string? _ticketMessage;
    private bool _ticketSuccess;
    private ElementReference _fileInput;

    private readonly List<QuickLink> _quickLinks = new()
    {
        new(
            "Primeiros passos",
            "Aprenda o básico e comece a usar rapidamente.",
            "<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 10V3L4 14h7v7l9-11h-7z\" /></svg>"
        ),
        new(
            "Conta e cobrança",
            "Gerencie sua assinatura, pagamentos e faturas.",
            "<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z\" /></svg>"
        ),
        new(
            "Suporte técnico",
            "Resolva problemas e obtenha ajuda técnica.",
            "<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\" /><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\" /></svg>"
        ),
        new(
            "Documentação da API",
            "Explore as referências, guias e exemplos da nossa API.",
            "<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\" /></svg>"
        ),
        new(
            "Privacidade e segurança",
            "Conheça as práticas de proteção de dados e segurança.",
            "<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\" /></svg>"
        ),
        new(
            "Fale conosco",
            "Entre em contato com nossa equipe para ajuda direta.",
            "<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\" /></svg>"
        )
    };

    private readonly List<FaqItem> _faqs = new()
    {
        new("Como faço para redefinir minha senha?",
            "Acesse a página de login e clique em 'Esqueceu a senha?'. Informe seu endereço de e-mail e você receberá um link de redefinição em poucos minutos. Abra o link para criar uma nova senha. Se o e-mail não chegar, verifique a caixa de spam ou fale com o suporte."),
        new("Como faço para atualizar meu plano de assinatura?",
            "Vá para Configurações > Cobrança e clique em 'Atualizar plano'. Você verá os planos disponíveis com os detalhes de preços. Selecione o plano desejado e conclua o pagamento. Sua conta será atualizada imediatamente."),
        new("Posso convidar membros de equipe para minha conta?",
            "Sim! Vá para Configurações > Membros da equipe e clique em 'Convidar'. Informe os endereços de e-mail e atribua os papéis (Admin, Editor ou Viewer). Eles receberão um e-mail de convite para entrar no seu workspace."),
        new("Como faço para exportar meus dados?",
            "Vá para Configurações > Gerenciamento de dados e clique em 'Exportar dados'. Escolha os tipos de dados que deseja exportar (contatos, transações, relatórios) e selecione o formato preferido (CSV, Excel ou JSON). O download começará automaticamente."),
        new("Quais formas de pagamento vocês aceitam?",
            "Aceitamos os principais cartões de crédito e débito (Visa, MasterCard, American Express), PayPal e transferência bancária para planos anuais. Todas as transações são processadas com segurança pelo Stripe."),
        new("Existe avaliação gratuita disponível?",
            "Sim, oferecemos uma avaliação gratuita de 14 dias com acesso completo a todos os recursos. Não é necessário cartão de crédito para começar. Ao final do período, você pode escolher o plano ideal para você."),
        new("Como faço para cancelar minha assinatura?",
            "Vá para Configurações > Cobrança > Assinatura e clique em 'Cancelar plano'. Seu acesso continuará até o fim do período de cobrança atual. Você pode reativar a qualquer momento pela mesma página."),
        new("Quais são os tempos de resposta do suporte?",
            "Buscamos responder todos os chamados em até 24 horas em dias úteis. Clientes com suporte prioritário recebem resposta em até 4 horas. O chat ao vivo está disponível de segunda a sexta, das 9h às 18h (EST)."),
        new("Vocês oferecem reembolso?",
            "Oferecemos reembolso integral em até 7 dias após a compra caso você não fique satisfeito. Após esse período, os reembolsos são analisados caso a caso. Fale com nossa equipe de suporte para obter ajuda."),
        new("Como ativo a autenticação de dois fatores?",
            "Vá para Configurações > Segurança e clique em 'Ativar 2FA'. Você pode escolher entre aplicativo autenticador ou verificação por SMS. Recomendamos fortemente ativar o 2FA para manter sua conta segura.")
    };

    private readonly List<ArticleItem> _articles = new()
    {
        new("Guia de introdução: seus primeiros passos", "12,450"),
        new("Como configurar seu Dashboard em 5 minutos", "9,830"),
        new("Entendendo análises e relatórios", "8,210"),
        new("Gerenciando sua equipe e permissões", "7,650"),
        new("Integrando serviços de terceiros", "6,920"),
        new("Guia de importação e migração de dados", "5,440"),
        new("Personalizando seu workspace", "4,870"),
        new("Resolvendo problemas comuns", "4,230")
    };

    private void ToggleFaq(FaqItem faq)
    {
        faq.IsOpen = !faq.IsOpen;
    }

    private async Task SubmitTicket()
    {
        if (string.IsNullOrWhiteSpace(_ticketSubject) || string.IsNullOrWhiteSpace(_ticketDescription))
        {
            _ticketMessage = "Preencha o assunto e a descrição.";
            _ticketSuccess = false;
            return;
        }

        await Task.Delay(500);
        _ticketMessage = "Seu chamado foi enviado com sucesso! Entraremos em contato em até 24 horas.";
        _ticketSuccess = true;
        _ticketSubject = "";
        _ticketCategory = "";
        _ticketPriority = "";
        _ticketDescription = "";
    }

    private record QuickLink(string Title, string Description, string Icon);
    private class FaqItem
    {
        public string Question { get; }
        public string Answer { get; }
        public bool IsOpen { get; set; }

        public FaqItem(string question, string answer)
        {
            Question = question;
            Answer = answer;
        }
    }
    private record ArticleItem(string Title, string Views);
}
