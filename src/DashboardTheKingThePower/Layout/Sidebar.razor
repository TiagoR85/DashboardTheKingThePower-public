</aside>

@if (IsMobile && !IsCollapsed)
{
    <div class="fixed inset-0 bg-black/50 z-40" @onclick="HandleBackdropClick"></div>
}

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _sidebarName = "Usuário";
    private string _sidebarRole = "Usuário";

    // exibição apenas: os valores do Role seguem em inglês nas comparações (Users.razor)
    private string RoleLabel(string role) => role switch
    {
        "User" => "Usuário",
        "Admin" => "Administrador",
        "Editor" => "Editor",
        _ => role
    };
    private string _sidebarInitials = "U";

    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthStateProvider.GetCurrentUserAsync();
        if (user != null)
        {
            _sidebarName = user.Name;
            _sidebarRole = user.Role;
            _sidebarInitials = string.Concat(user.Name.Split(' ').Select(n => n[0].ToString())).ToUpper();
            if (_sidebarInitials.Length > 2) _sidebarInitials = _sidebarInitials.Substring(0, 2);
        }
    }

    private async Task HandleLogout()
    {
        await AuthStateProvider.LogoutAsync();
    }

    private string SidebarClass
    {
        get
        {
            if (IsMobile)
            {
                return IsCollapsed
                    ? "fixed left-0 top-0 h-screen w-[260px] bg-[var(--sidebar)] text-[var(--sidebar-foreground)] flex flex-col transition-all duration-300 z-50 border-r border-[var(--sidebar-border)] -translate-x-full"
                    : "fixed left-0 top-0 h-screen w-[260px] bg-[var(--sidebar)] text-[var(--sidebar-foreground)] flex flex-col transition-all duration-300 z-50 border-r border-[var(--sidebar-border)]";
            }
            return IsCollapsed
                ? "fixed left-0 top-0 h-screen w-[72px] bg-[var(--sidebar)] text-[var(--sidebar-foreground)] flex flex-col transition-all duration-300 z-50 border-r border-[var(--sidebar-border)]"
                : "fixed left-0 top-0 h-screen w-[260px] bg-[var(--sidebar)] text-[var(--sidebar-foreground)] flex flex-col transition-all duration-300 z-50 border-r border-[var(--sidebar-border)]";
        }
    }

    private string NavClass(string href)
    {
        var isActive = href == "/" ? CurrentPath == "/" : CurrentPath.StartsWith(href);
        var baseClass = "flex items-center gap-3 px-3 py-2 rounded-lg text-[var(--sidebar-foreground)] text-sm transition-all duration-300";
        var activeClass = isActive 
            ? "border-l-3 border-[var(--primary)] bg-[var(--sidebar-accent)] text-[var(--primary)] pl-2.5" 
            : "border-l-3 border-transparent hover:bg-[var(--sidebar-accent)] hover:translate-x-0.5";
        var collapsedClass = IsCollapsed ? "justify-center px-0 border-l-0" : "";
        return $"{baseClass} {activeClass} {collapsedClass}";
    }

    private async Task HandleToggle()
    {
        await OnToggle.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await OnClose.InvokeAsync();
    }
}
